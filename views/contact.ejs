<!DOCTYPE html>
<html lang="en">
<%- include('./partials/head.ejs') %>
<body>
    <%- include('./partials/nav.ejs') %>

    <div class="contact-page">
        <h1>Get in touch</h1>
        <p class="sub">Questions about seats, shifts, coaching, or fees? We're here.</p>

        <div class="contact-layout">
            <!-- Left: Info Panel -->
            <div class="contact-info">
                <h2>Reach us</h2>
                <p class="desc">Visit us or drop a message and we'll get back to you by the next business day.</p>

                <div class="contact-item-row">
                    <div class="ci-icon">📍</div>
                    <div class="ci-text">
                        <h4>Our Address</h4>
                        <p>Kharkhura near Sabji Mandi / 64 no. Gumti, GAYA</p>
                    </div>
                </div>

                <div class="contact-item-row">
                    <div class="ci-icon">📞</div>
                    <div class="ci-text">
                        <h4>Phone / WhatsApp</h4>
                        <p><a href="tel:6376598096" style="color:inherit; text-decoration:none;">+91 6376598096</a><br><a href="tel:6202803931" style="color:inherit; text-decoration:none;">+91 6202803931</a></p>
                    </div>
                </div>

                <div class="contact-item-row">
                    <div class="ci-icon">✉️</div>
                    <div class="ci-text">
                        <h4>Email</h4>
                        <p>info@sarvodayalibrary.com</p>
                    </div>
                </div>

                <div class="contact-item-row">
                    <div class="ci-icon">🕒</div>
                    <div class="ci-text">
                        <h4>Library Hours</h4>
                        <p>Open 24 × 7 across all 5 shifts<br>Admin desk: 10 AM – 5 PM daily</p>
                    </div>
                </div>
            </div>

            <!-- Right: Form -->
            <div class="contact-form-box">
                <h2>Send a message</h2>

                <div id="errorAlert" class="alert alert-error" style="display:none;" role="alert"></div>
                <div id="successAlert" class="alert alert-success" style="display:none;" role="status"></div>

                <form id="contactForm" novalidate>
                    <div class="form-group">
                        <label class="form-label" for="contactName">Full name</label>
                        <input class="form-input" type="text" id="contactName" name="name" placeholder="Rahul Sharma" required>
                    </div>

                    <div class="form-group">
                        <label class="form-label" for="contactPhone">Phone number</label>
                        <input class="form-input" type="tel" id="contactPhone" name="number" placeholder="+91 98765 43210" required>
                    </div>

                    <div class="form-group">
                        <label class="form-label" for="contactMessage">Your message</label>
                        <textarea class="form-input" id="contactMessage" name="message" rows="4" placeholder="I'd like to know about available seats for the morning shift…" required style="resize:vertical; min-height:110px;"></textarea>
                    </div>

                    <button type="submit" class="btn btn-primary" style="width:100%; padding:13px; font-size:15px;">
                        Send Message →
                    </button>
                </form>
            </div>
        </div>
    </div>

    <script>
        const form = document.getElementById('contactForm');
        const errorAlert = document.getElementById('errorAlert');
        const successAlert = document.getElementById('successAlert');

        form.addEventListener('submit', function(e) {
            e.preventDefault();
            errorAlert.style.display = 'none';
            successAlert.style.display = 'none';

            setTimeout(function() {
                successAlert.textContent = '✓  Thank you! We received your message and will get back to you soon.';
                successAlert.style.display = 'flex';
                form.reset();
            }, 600);
        });
    </script>
</body>
</html>
