<!DOCTYPE html>
<html lang="en">
<%- include('./partials/head.ejs') %>
<style>
    :root {
        --primary: var(--brand);
        --primary-hover: var(--brand-hover);
        --text-main: var(--fg);
        --text-muted: var(--fg-muted);
    }

    .coaching-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
        gap: 16px;
        margin-top: 4px;
    }

    .coaching-card {
        background: #fff;
        border: 1.5px solid var(--border);
        border-radius: var(--r-lg);
        padding: 20px 18px;
        cursor: pointer;
        transition: all 0.22s var(--ease);
        position: relative;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        min-height: 155px;
    }

    .coaching-card:hover {
        border-color: var(--amber);
        transform: translateY(-4px);
        box-shadow: var(--shadow-lg);
    }

    .batch-badge {
        position: absolute;
        top: 14px; right: 14px;
        background: var(--amber-light);
        color: var(--amber);
        font-size: 10.5px;
        font-weight: 700;
        padding: 3px 9px;
        border-radius: var(--r-full);
        border: 1px solid #fde68a;
        text-transform: uppercase;
        letter-spacing: 0.06em;
    }

    .subject-info {
        font-size: 12.5px;
        color: var(--fg-muted);
        font-weight: 500;
        margin-bottom: 3px;
    }
</style>

<body>
    <%- include('./partials/nav.ejs') %>

    <div class="container" style="padding-top: 8px; padding-bottom: 60px;">

        <!-- Switcher + WhatsApp badge row -->
        <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:12px; margin-bottom:8px;">
            <div class="dash-switcher">
                <a href="/admin/dashboard">← Overview</a>
                <a href="/admin/dashboard/library">📚 Library</a>
                <a href="/admin/dashboard/coaching" class="active">🎓 Coaching</a>
            </div>

            <div id="waStatusBadge" style="cursor:pointer; display:flex; align-items:center; gap:8px; font-size:13px; font-weight:600; padding:7px 14px; background:#fff; border:1px solid var(--border); border-radius:var(--r-full); box-shadow:var(--shadow-xs);" onclick="openWaModal()">
                <span class="wa-dot" id="waDot"></span>
                <span id="waText">Checking WhatsApp…</span>
            </div>
        </div>

        <!-- Page header -->
        <div class="dashboard-header">
            <h1 class="dashboard-title">Coaching students</h1>
            <div class="dashboard-controls">
                <div class="search-box">
                    <input type="text" id="searchInput" placeholder="Search name, phone, batch…" onkeyup="if(event.key==='Enter') triggerSearch()">
                    <button onclick="triggerSearch()">Search</button>
                </div>
                <select id="statusFilter" onchange="triggerSearch()" style="padding:10px 14px; border:1px solid var(--border); border-radius:var(--r-sm); font-size:14px; font-weight:600; color:var(--fg); background:var(--bg-elevated); cursor:pointer; outline:none;">
                    <option value="">All statuses</option>
                    <option value="paid">Paid</option>
                    <option value="unpaid">Unpaid</option>
                </select>
                <a href="/admin/analytics/coaching" class="btn btn-secondary" style="font-weight:700; cursor:pointer; display:inline-flex; align-items:center; gap:6px; text-decoration:none;">📊 Revenue Analytics</a>
                <a href="/admin/coaching/register" class="btn btn-green" style="text-decoration:none;">+ Add student</a>
            </div>
        </div>

        <!-- Student Grid -->
        <div id="coachingGrid" class="coaching-grid"></div>

        <!-- Empty State -->
        <div id="emptyState" class="empty-state" style="display:none;">
            <div class="empty-icon">🎓</div>
            <h3>No coaching students found</h3>
            <p>Try adjusting your filter or register a new student.</p>
            <a href="/admin/coaching/register" class="btn btn-primary">+ Register student</a>
        </div>
    </div>

    <!-- COACHING STUDENT DETAILS / EDIT MODAL -->
    <div id="studentModal" class="modal-overlay">
        <div class="modal-content">
            <button class="close-btn" onclick="closeStudentModal()">&times;</button>
            <h2 class="modal-title">Coaching Student Details</h2>
            
            <form id="editStudentForm" onsubmit="saveStudentChanges(event)">
                <input type="hidden" id="modalStudentId">

                <div class="form-group" style="margin-bottom: 12px;">
                    <label style="font-size: 12px; font-weight: 600; color: #64748b;">Full Name</label>
                    <input type="text" id="modalName" required style="width: 100%; padding: 8px 12px; border-radius: 8px; border: 1px solid #cbd5e1;">
                </div>

                <div class="form-group" style="margin-bottom: 12px;">
                    <label style="font-size: 12px; font-weight: 600; color: #64748b;">Phone Number</label>
                    <input type="tel" id="modalPhone" required style="width: 100%; padding: 8px 12px; border-radius: 8px; border: 1px solid #cbd5e1;">
                </div>

                <div class="form-group" style="margin-bottom: 12px;">
                    <label style="font-size: 12px; font-weight: 600; color: #64748b;">Batch / Class</label>
                    <input type="text" id="modalBatch" required style="width: 100%; padding: 8px 12px; border-radius: 8px; border: 1px solid #cbd5e1;">
                </div>

                <div class="form-group" style="margin-bottom: 12px;">
                    <label style="font-size: 12px; font-weight: 600; color: #64748b;">Subject(s)</label>
                    <input type="text" id="modalSubject" placeholder="e.g. Physics, Math" style="width: 100%; padding: 8px 12px; border-radius: 8px; border: 1px solid #cbd5e1;">
                </div>

                <div class="form-group" style="margin-bottom: 12px;">
                    <label style="font-size: 12px; font-weight: 600; color: #64748b;">Monthly Fee (₹)</label>
                    <input type="number" id="modalMonthlyFee" style="width: 100%; padding: 8px 12px; border-radius: 8px; border: 1px solid #cbd5e1;">
                </div>

                <div class="form-group" style="margin-bottom: 12px;">
                    <label style="font-size: 12px; font-weight: 600; color: #64748b;">Fee Status</label>
                    <select id="modalFeePaid" style="width: 100%; padding: 8px 12px; border-radius: 8px; border: 1px solid #cbd5e1; font-weight: 600;">
                        <option value="true">Paid</option>
                        <option value="false">Unpaid</option>
                    </select>
                </div>

                <div class="form-group" style="margin-bottom: 16px;">
                    <label style="font-size: 12px; font-weight: 600; color: #64748b;">Fee Expiry Date</label>
                    <input type="date" id="modalFeeExpireDate" style="width: 100%; padding: 8px 12px; border-radius: 8px; border: 1px solid #cbd5e1;">
                </div>

                <!-- Renewal Button -->
                <button type="button" onclick="renewCoachingFee()" class="btn btn-green" style="width: 100%; padding: 12px; border-radius: 8px; font-weight: 700; cursor: pointer; margin-bottom: 10px; border: none;">
                    Renew Monthly Fee (+30 Days)
                </button>

                <div style="display: flex; gap: 10px;">
                    <button type="submit" class="btn" style="flex: 1; padding: 10px; background-color: #4f46e5; color: white; border: none; border-radius: 8px; font-weight: 700; cursor: pointer;">Save Changes</button>
                    <button type="button" onclick="deleteCoachingStudent()" class="btn btn-red" style="padding: 10px 14px; border: none; border-radius: 8px; font-weight: 700; cursor: pointer;">Delete</button>
                </div>
            </form>
        </div>
    </div>

    <!-- WHATSAPP STATUS / QR MODAL -->
    <div id="waModal" class="modal-overlay">
        <div class="modal-content" style="text-align: center;">
            <button class="close-btn" onclick="closeWaModal()">&times;</button>
            <h2 class="modal-title">WhatsApp Web Service</h2>
            <div id="waModalBody" style="margin: 20px 0;">
                <p>Loading WhatsApp status...</p>
            </div>
            <button onclick="checkWhatsAppStatus()" class="btn" style="background: #f1f5f9; color: #334155; border: 1px solid #cbd5e1; padding: 8px 16px; border-radius: 8px; font-weight: 600; cursor: pointer;">Refresh Status</button>
        </div>
    </div>

    <script>
        let currentStudentsData = [];

        document.addEventListener('DOMContentLoaded', () => {
            fetchCoachingData();
            checkWhatsAppStatus();
            setInterval(checkWhatsAppStatus, 15000);
        });

        async function fetchCoachingData() {
            const search = document.getElementById('searchInput').value.trim();
            const status = document.getElementById('statusFilter').value;

            const queryParams = new URLSearchParams();
            if (search) queryParams.append('search', search);
            if (status) queryParams.append('status', status);

            try {
                const res = await fetch(`/admin/coaching/dashboard-data?${queryParams.toString()}`);
                const data = await res.json();
                
                if (res.ok) {
                    currentStudentsData = data.students || [];
                    renderStudents(currentStudentsData);
                } else {
                    alert(data.error || 'Failed to fetch coaching data');
                }
            } catch (err) {
                console.error(err);
            }
        }

        function triggerSearch() {
            fetchCoachingData();
        }

        function renderStudents(students) {
            const grid = document.getElementById('coachingGrid');
            const emptyState = document.getElementById('emptyState');

            if (!students || students.length === 0) {
                grid.style.display = 'none';
                emptyState.style.display = 'block';
                return;
            }

            grid.style.display = 'grid';
            emptyState.style.display = 'none';

            grid.innerHTML = students.map(student => {
                const statusClass = student.feePaid ? 'status-paid' : 'status-unpaid';
                const statusText = student.feePaid ? 'Paid' : 'Unpaid';
                const expiryDate = student.feeExpireDate 
                    ? new Date(student.feeExpireDate).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' })
                    : 'N/A';

                return `
                    <div class="coaching-card" onclick="openStudentModal('${student._id}')">
                        <span class="batch-badge">${escapeHtml(student.batch)}</span>
                        <div>
                            <h3 class="student-name">${escapeHtml(student.name)}</h3>
                            <div class="subject-info">📞 ${escapeHtml(student.phone)}</div>
                            ${student.subject ? `<div class="subject-info">📖 ${escapeHtml(student.subject)}</div>` : ''}
                            ${student.monthlyFee ? `<div class="subject-info">💵 ₹${student.monthlyFee}/month</div>` : ''}
                        </div>
                        <div style="margin-top: 14px; display: flex; justify-content: space-between; align-items: center;">
                            <span class="status-badge ${statusClass}">${statusText}</span>
                            <span class="expiry-info" style="margin:0;">Exp: ${expiryDate}</span>
                        </div>
                    </div>
                `;
            }).join('');
        }

        function escapeHtml(str) {
            if (!str) return '';
            return str.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
        }

        function openStudentModal(id) {
            const student = currentStudentsData.find(s => s._id === id);
            if (!student) return;

            document.getElementById('modalStudentId').value = student._id;
            document.getElementById('modalName').value = student.name;
            document.getElementById('modalPhone').value = student.phone;
            document.getElementById('modalBatch').value = student.batch;
            document.getElementById('modalSubject').value = student.subject || '';
            document.getElementById('modalMonthlyFee').value = student.monthlyFee || 0;
            document.getElementById('modalFeePaid').value = student.feePaid ? 'true' : 'false';

            if (student.feeExpireDate) {
                const d = new Date(student.feeExpireDate);
                const year = d.getFullYear();
                const month = String(d.getMonth() + 1).padStart(2, '0');
                const day = String(d.getDate()).padStart(2, '0');
                document.getElementById('modalFeeExpireDate').value = `${year}-${month}-${day}`;
            } else {
                document.getElementById('modalFeeExpireDate').value = '';
            }

            document.getElementById('studentModal').style.display = 'flex';
        }

        function closeStudentModal() {
            document.getElementById('studentModal').style.display = 'none';
        }

        async function renewCoachingFee() {
            const studentId = document.getElementById('modalStudentId').value;
            if (!studentId) return;

            try {
                const res = await fetch('/admin/coaching/renew-fee', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ studentId })
                });
                const data = await res.json();
                if (res.ok) {
                    alert('Fee renewed successfully (+30 Days)');
                    closeStudentModal();
                    fetchCoachingData();
                } else {
                    alert(data.error || 'Failed to renew fee');
                }
            } catch (err) {
                console.error(err);
            }
        }

        async function saveStudentChanges(e) {
            e.preventDefault();
            const studentId = document.getElementById('modalStudentId').value;
            const name = document.getElementById('modalName').value;
            const phone = document.getElementById('modalPhone').value;
            const batch = document.getElementById('modalBatch').value;
            const subject = document.getElementById('modalSubject').value;
            const monthlyFee = document.getElementById('modalMonthlyFee').value;
            const feePaid = document.getElementById('modalFeePaid').value === 'true';
            const feeExpireDate = document.getElementById('modalFeeExpireDate').value;

            try {
                const res = await fetch('/admin/coaching/update-student', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ studentId, name, phone, batch, subject, monthlyFee, feePaid, feeExpireDate })
                });
                const data = await res.json();
                if (res.ok) {
                    alert('Student updated successfully');
                    closeStudentModal();
                    fetchCoachingData();
                } else {
                    alert(data.error || 'Failed to update student');
                }
            } catch (err) {
                console.error(err);
            }
        }

        async function deleteCoachingStudent() {
            const studentId = document.getElementById('modalStudentId').value;
            if (!studentId) return;
            if (!confirm('Are you sure you want to delete this coaching student?')) return;

            try {
                const res = await fetch('/admin/coaching/delete-student', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ studentId })
                });
                const data = await res.json();
                if (res.ok) {
                    alert('Coaching student deleted');
                    closeStudentModal();
                    fetchCoachingData();
                } else {
                    alert(data.error || 'Failed to delete student');
                }
            } catch (err) {
                console.error(err);
            }
        }

        // --- WHATSAPP UTILITIES ---
        async function checkWhatsAppStatus() {
            try {
                const res = await fetch('/admin/whatsapp-status');
                const data = await res.json();
                const dot = document.getElementById('waDot');
                const text = document.getElementById('waText');
                const modalBody = document.getElementById('waModalBody');

                if (data.status === 'READY') {
                    window.whatsappStatus = 'READY';
                    dot.style.background = '#10b981';
                    text.innerText = 'WhatsApp Connected';
                    modalBody.innerHTML = '<p style="color: #059669; font-weight: 700;">✅ WhatsApp client is active and connected!</p>';
                } else if (data.status === 'QR' && data.qr) {
                    window.whatsappStatus = 'QR';
                    dot.style.background = '#f59e0b';
                    text.innerText = 'Scan QR Code';
                    modalBody.innerHTML = `
                        <p style="margin-bottom: 12px; font-weight:600;">Scan this QR code with WhatsApp on your phone:</p>
                        <img src="${data.qr}" alt="WhatsApp QR Code" style="width: 220px; border-radius: 12px; border: 1px solid #e2e8f0;">
                    `;
                } else if (data.status === 'CONNECTING') {
                    window.whatsappStatus = 'CONNECTING';
                    dot.style.background = '#3b82f6';
                    text.innerText = 'Connecting…';
                    modalBody.innerHTML = '<p style="color: #2563eb; font-weight: 600;">⏳ Initializing WhatsApp client... Please wait a moment.</p>';
                } else {
                    window.whatsappStatus = 'DISCONNECTED';
                    dot.style.background = '#ef4444';
                    text.innerText = 'WhatsApp Disconnected';
                    modalBody.innerHTML = `
                        <div style="padding: 10px 0;">
                            <p style="color: #dc2626; font-weight: 600; margin-bottom: 14px;">⚠️ WhatsApp is currently disconnected.</p>
                            <button onclick="reconnectWhatsAppClient(event)" class="btn btn-primary" style="padding: 10px 18px; font-size: 14px; font-weight: 700; border-radius: 8px; cursor: pointer;">
                                📷 Show QR Code / Reconnect
                            </button>
                        </div>
                    `;
                }
            } catch (err) {
                console.error(err);
            }
        }

        async function reconnectWhatsAppClient(e) {
            if (e) e.preventDefault();
            const modalBody = document.getElementById('waModalBody');
            const text = document.getElementById('waText');
            if (text) text.innerText = 'Generating QR Code…';
            if (modalBody) modalBody.innerHTML = '<p style="color: #4f46e5; font-weight: 600;">⌛ Launching browser and generating fresh QR code...</p>';

            try {
                await fetch('/admin/whatsapp-reconnect', { method: 'POST' });
                let count = 0;
                const interval = setInterval(async () => {
                    count++;
                    await checkWhatsAppStatus();
                    if (window.whatsappStatus === 'QR' || window.whatsappStatus === 'READY' || count > 12) {
                        clearInterval(interval);
                    }
                }, 1500);
            } catch (err) {
                if (modalBody) modalBody.innerHTML = '<p style="color: #dc2626;">Failed to restart WhatsApp client.</p>';
            }
        }

        function openWaModal() {
            document.getElementById('waModal').style.display = 'flex';
        }

        function closeWaModal() {
            document.getElementById('waModal').style.display = 'none';
        }
    </script>

    <!-- Coaching Financial Analytics Modal -->
    <div id="coachingAnalyticsModal" class="modal-overlay" style="display:none; align-items:center; justify-content:center; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.65); z-index:99995;">
        <div style="background:var(--bg-elevated); border:1.5px solid var(--border); border-radius:18px; padding:26px; max-width:640px; width:92%; max-height:90vh; overflow-y:auto; box-shadow:0 12px 35px rgba(0,0,0,0.25); position:relative;">
            <button onclick="closeCoachingAnalyticsModal()" style="position:absolute; top:14px; right:16px; background:none; border:none; font-size:24px; cursor:pointer; color:var(--fg-muted); font-weight:700;">&times;</button>
            
            <div style="display:flex; align-items:center; gap:10px; margin-bottom:4px;">
                <span style="font-size:24px;">🎓</span>
                <h2 style="font-family:'DM Serif Display', Georgia, serif; font-size:24px; color:var(--fg); margin:0;">Coaching Financial Analytics</h2>
            </div>
            <p style="font-size:13px; color:var(--fg-muted); margin-bottom:18px;">Detailed batch-wise revenue, monthly collection, and pending fee breakdown.</p>

            <!-- 4 Quick Stats Cards -->
            <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(125px, 1fr)); gap:12px; margin-bottom:20px;">
                <div style="background:#ecfdf5; border:1px solid #a7f3d0; border-radius:12px; padding:14px; text-align:center;">
                    <span style="font-size:11px; font-weight:700; color:#047857; text-transform:uppercase;">Collected</span>
                    <div id="coachingPaidRev" style="font-size:19px; font-weight:800; color:#059669; margin-top:2px;">₹0</div>
                </div>
                <div style="background:#fef2f2; border:1px solid #fecaca; border-radius:12px; padding:14px; text-align:center;">
                    <span style="font-size:11px; font-weight:700; color:#b91c1c; text-transform:uppercase;">Pending Dues</span>
                    <div id="coachingPendingRev" style="font-size:19px; font-weight:800; color:#dc2626; margin-top:2px;">₹0</div>
                </div>
                <div style="background:#eff6ff; border:1px solid #bfdbfe; border-radius:12px; padding:14px; text-align:center;">
                    <span style="font-size:11px; font-weight:700; color:#1d4ed8; text-transform:uppercase;">Target Total</span>
                    <div id="coachingProjectedRev" style="font-size:19px; font-weight:800; color:#2563eb; margin-top:2px;">₹0</div>
                </div>
                <div style="background:#fef3c7; border:1px solid #fde68a; border-radius:12px; padding:14px; text-align:center;">
                    <span style="font-size:11px; font-weight:700; color:#b45309; text-transform:uppercase;">Collection Rate</span>
                    <div id="coachingRate" style="font-size:19px; font-weight:800; color:#d97706; margin-top:2px;">0%</div>
                </div>
            </div>

            <!-- Batch Breakdown Table -->
            <div style="margin-bottom:20px; background:var(--bg-subtle); border:1px solid var(--border); border-radius:14px; padding:16px;">
                <h4 style="font-size:14px; font-weight:700; margin:0 0 12px 0; color:var(--fg);">📚 Batch-wise Revenue Breakdown</h4>
                <div id="coachingBatchBreakdown" style="font-size:13px;">Loading batches...</div>
            </div>

            <!-- Trend Chart -->
            <div style="background:var(--bg-subtle); border:1px solid var(--border); border-radius:14px; padding:16px;">
                <h4 style="font-size:14px; font-weight:700; margin:0 0 10px 0; color:var(--fg);">📈 6-Month Coaching Revenue Trend</h4>
                <div style="height:190px; position:relative;">
                    <canvas id="coachingTrendChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        let coachingChartInstance = null;

        async function openCoachingAnalyticsModal() {
            const modal = document.getElementById('coachingAnalyticsModal');
            if (modal) modal.style.display = 'flex';

            document.getElementById('coachingBatchBreakdown').innerHTML = '<p style="color:var(--fg-muted);">Loading live coaching analytics...</p>';

            try {
                const res = await fetch('/admin/analytics-data?type=coaching');
                const data = await res.json();

                document.getElementById('coachingPaidRev').textContent = '₹' + (data.totalPaid || 0).toLocaleString('en-IN');
                document.getElementById('coachingPendingRev').textContent = '₹' + (data.totalPending || 0).toLocaleString('en-IN');
                document.getElementById('coachingProjectedRev').textContent = '₹' + (data.totalProjected || 0).toLocaleString('en-IN');
                document.getElementById('coachingRate').textContent = (data.collectionRate || 0) + '%';

                // Render Batch Breakdown
                if (data.batchBreakdown) {
                    let html = `<div style="display:flex; flex-direction:column; gap:8px;">`;
                    Object.keys(data.batchBreakdown).forEach(batchName => {
                        const info = data.batchBreakdown[batchName];
                        html += `
                            <div style="display:flex; justify-content:space-between; align-items:center; background:#ffffff; border:1px solid var(--border); border-radius:8px; padding:8px 12px;">
                                <div>
                                    <strong style="color:var(--fg);">Batch: ${batchName}</strong>
                                    <span style="font-size:11.5px; color:var(--fg-muted); margin-left:6px;">(${info.paidCount} paid, ${info.unpaidCount} overdue)</span>
                                </div>
                                <div style="text-align:right;">
                                    <span style="color:#059669; font-weight:700;">₹${info.paidRev.toLocaleString('en-IN')}</span>
                                    <span style="color:#dc2626; font-size:11.5px; margin-left:6px;">(Pending ₹${info.pendingRev.toLocaleString('en-IN')})</span>
                                </div>
                            </div>
                        `;
                    });
                    html += `</div>`;
                    document.getElementById('coachingBatchBreakdown').innerHTML = html;
                }

                // Render Trend Chart
                const ctx = document.getElementById('coachingTrendChart');
                if (ctx) {
                    if (coachingChartInstance) coachingChartInstance.destroy();
                    coachingChartInstance = new Chart(ctx, {
                        type: 'line',
                        data: {
                            labels: data.months || [],
                            datasets: [{
                                label: 'Coaching Revenue (₹)',
                                data: data.trend || [],
                                borderColor: '#d97706',
                                backgroundColor: 'rgba(217, 119, 6, 0.12)',
                                fill: true,
                                tension: 0.3,
                                pointBackgroundColor: '#d97706',
                                pointRadius: 4
                            }]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            plugins: {
                                legend: { display: false },
                                tooltip: {
                                    callbacks: {
                                        label: function(ctx) { return 'Revenue: ₹' + ctx.raw.toLocaleString('en-IN'); }
                                    }
                                }
                            },
                            scales: {
                                x: { grid: { display: false }, ticks: { font: { family: 'Inter', size: 11 } } },
                                y: { beginAtZero: true, grid: { color: '#e2e8f0' }, ticks: { font: { family: 'Inter', size: 10 }, callback: v => '₹' + v } }
                            }
                        }
                    });
                }

            } catch (err) {
                console.error(err);
                document.getElementById('coachingBatchBreakdown').innerHTML = '<p style="color:red;">Failed to load analytics data.</p>';
            }
        }

        function closeCoachingAnalyticsModal() {
            const modal = document.getElementById('coachingAnalyticsModal');
            if (modal) modal.style.display = 'none';
        }
    </script>
</body>
</html>
