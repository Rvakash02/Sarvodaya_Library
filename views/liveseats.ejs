<!DOCTYPE html>
<html lang="en">
<%- include('./partials/head.ejs') %>
<body>
    <%- include('./partials/nav.ejs') %>

    <div class="liveseats-page">
        <h1>Live seat availability</h1>
        <p class="sub">Select one or more shifts to see which seats are open right now.</p>

        <!-- Shift Selector Card -->
        <div class="shift-selector-card">
            <h3>Select Shifts</h3>

            <div class="shift-pills-row">
                <label class="shift-pill">
                    <input type="checkbox" name="liveShifts" value="6am-10am" checked onchange="fetchLiveSeats()">
                    6 AM – 10 AM
                </label>
                <label class="shift-pill">
                    <input type="checkbox" name="liveShifts" value="10am-2pm" onchange="fetchLiveSeats()">
                    10 AM – 2 PM
                </label>
                <label class="shift-pill">
                    <input type="checkbox" name="liveShifts" value="2pm-6pm" onchange="fetchLiveSeats()">
                    2 PM – 6 PM
                </label>
                <label class="shift-pill">
                    <input type="checkbox" name="liveShifts" value="6pm-10pm" onchange="fetchLiveSeats()">
                    6 PM – 10 PM
                </label>
                <label class="shift-pill">
                    <input type="checkbox" name="liveShifts" value="night" onchange="fetchLiveSeats()">
                    Night
                </label>
            </div>

            <!-- Legend -->
            <div class="legend-row">
                <div class="legend-item">
                    <div class="legend-dot" style="background:#dcfce7; border:1.5px solid #86efac;"></div>
                    Vacant — available
                </div>
                <div class="legend-item">
                    <div class="legend-dot" style="background:#f4f3f2; border:1.5px solid #e7e5e4;"></div>
                    Booked
                </div>
            </div>
        </div>

        <!-- Seating map -->
        <div class="seating-chart">
            <div id="vacantCountHeader" class="chart-header">
                Loading seating map…
            </div>
            <div id="seatingGrid" class="grid-container"></div>
        </div>
    </div>

    <script>
        async function fetchLiveSeats() {
            const checked = document.querySelectorAll('input[name="liveShifts"]:checked');
            const shifts  = Array.from(checked).map(cb => cb.value);
            const grid    = document.getElementById('seatingGrid');
            const header  = document.getElementById('vacantCountHeader');

            if (!shifts.length) {
                header.textContent = 'No shift selected';
                grid.innerHTML = '<p style="grid-column:1/-1;text-align:center;color:var(--fg-muted);padding:24px 0;">Select at least one shift to see availability.</p>';
                return;
            }

            grid.innerHTML = '<p style="grid-column:1/-1;text-align:center;color:var(--fg-muted);padding:24px 0;">Updating…</p>';

            try {
                const res  = await fetch('/user/liveseats-data?shifts=' + shifts.join(','));
                const data = await res.json();

                if (!res.ok) {
                    header.textContent = 'Error loading seats';
                    grid.innerHTML = '<p style="grid-column:1/-1;text-align:center;color:var(--red);padding:24px 0;">' + (data.error || 'Server error') + '</p>';
                    return;
                }

                const vacant = data.vacantSeats || [];
                header.textContent = vacant.length + ' of 43 seats available';

                let html = '';
                for (let i = 1; i <= 43; i++) {
                    const isVacant = vacant.includes(i);
                    html += isVacant
                        ? `<div class="seat-box seat-available" title="Seat ${i} — Available"><span class="num">${i}</span><span class="lbl">Open</span></div>`
                        : `<div class="seat-box seat-occupied" title="Seat ${i} — Booked"><span class="num">${i}</span><span class="lbl">Taken</span></div>`;
                }
                grid.innerHTML = html;
            } catch (err) {
                grid.innerHTML = '<p style="grid-column:1/-1;text-align:center;color:var(--red);padding:24px 0;">Connection error — please refresh.</p>';
            }
        }

        document.addEventListener('DOMContentLoaded', fetchLiveSeats);
    </script>
</body>
</html>
