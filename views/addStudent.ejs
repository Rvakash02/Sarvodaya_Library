<!DOCTYPE html>
<html lang="en">
<%- include('./partials/head.ejs') %>
<body>
     <%- include('./partials/nav.ejs') %>
    <div class="container" style="max-width: 700px; margin-top: 40px; padding-bottom: 60px;">
        <a href="/admin/dashboard/library" class="btn btn-secondary btn-sm" style="margin-bottom: 20px;">← Back to Library</a>

        <h1 style="font-size:clamp(24px,3.5vw,34px); margin-bottom:6px;">Register library student</h1>
        <p style="color:var(--fg-muted); font-size:15px; margin-bottom:28px;">Add a new student to the library management system.</p>

        <div id="errorAlert" class="alert alert-error" style="display: none;"></div>
        <div id="successAlert" class="alert alert-success" style="display: none;"></div>

        <div class="form-card">
            <form id="studentForm">
                <div class="form-group">
                    <label class="form-label" for="name">Full name</label>
                    <input class="form-input" type="text" id="name" name="name" placeholder="Rahul Sharma" required>
                </div>

                <div class="form-group">
                    <label class="form-label" for="phone">Phone number</label>
                    <input class="form-input" type="tel" id="phone" name="phone" placeholder="91XXXXXXXXXX" required>
                    <span class="form-hint">Include country code (e.g. 91XXXXXXXXXX for India)</span>
                </div>

                <div class="form-group">
                    <label class="form-label" for="seatNumber">Assigned seat (1 – 43)</label>
                    <input class="form-input" type="number" id="seatNumber" name="seatNumber" min="1" max="43" placeholder="e.g. 12" required>
                </div>

                <div class="form-group">
                    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:6px;">
                        <label class="form-label" style="margin:0;">Select Shifts (Select multiple)</label>
                        <button type="button" onclick="selectAllAddShifts()" style="background:none; border:none; color:var(--brand); font-size:12px; font-weight:600; cursor:pointer; padding:0;">Select All / Clear</button>
                    </div>
                    <div style="display:grid; grid-template-columns:repeat(2,1fr); gap:8px; margin-top:4px;">
                        <label class="shift-pill"><input type="checkbox" name="shifts" value="6am-10am"> 6 AM – 10 AM</label>
                        <label class="shift-pill"><input type="checkbox" name="shifts" value="10am-2pm"> 10 AM – 2 PM</label>
                        <label class="shift-pill"><input type="checkbox" name="shifts" value="2pm-6pm"> 2 PM – 6 PM</label>
                        <label class="shift-pill"><input type="checkbox" name="shifts" value="6pm-10pm"> 6 PM – 10 PM</label>
                        <label class="shift-pill" style="grid-column:span 2;"><input type="checkbox" name="shifts" value="night"> Night shift (10 PM onwards)</label>
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label" for="monthlyFee">Monthly Fee / Amount (₹)</label>
                    <input class="form-input" type="number" id="monthlyFee" name="monthlyFee" placeholder="e.g. 500" min="0" required>
                </div>

                <div class="form-group">
                    <div style="display:flex; align-items:center; justify-content:space-between; background:var(--bg-subtle); border:1px solid var(--border); border-radius:var(--r-md); padding:14px 16px;">
                        <span style="font-weight:600; font-size:14px;">Fee paid</span>
                        <label class="switch" style="margin:0;">
                            <input type="checkbox" id="feePaid" name="feePaid" value="true">
                            <span class="slider"></span>
                        </label>
                    </div>
                </div>

                <button type="submit" class="btn btn-primary" style="width:100%; padding:14px; font-size:15px; margin-top:8px;">Register student</button>
            </form>
        </div>
    </div>

    <script>
        window.addEventListener('DOMContentLoaded', () => {
            const urlParams = new URLSearchParams(window.location.search);
            const seat = urlParams.get('seatNumber');
            if (seat) {
                const seatInput = document.getElementById('seatNumber');
                if (seatInput) seatInput.value = seat;
            }
        });

        function selectAllAddShifts() {
            const checkboxes = document.querySelectorAll('input[name="shifts"]');
            const allChecked = Array.from(checkboxes).every(cb => cb.checked);
            checkboxes.forEach(cb => {
                cb.checked = !allChecked;
                const pill = cb.closest('.shift-pill');
                if (pill) {
                    if (cb.checked) pill.classList.add('selected');
                    else pill.classList.remove('selected');
                }
            });
        }

        // Toggle selected visual styling on shift labels when checked
        document.addEventListener('change', (e) => {
            if (e.target && e.target.name === 'shifts') {
                const pill = e.target.closest('.shift-pill');
                if (pill) {
                    if (e.target.checked) pill.classList.add('selected');
                    else pill.classList.remove('selected');
                }
            }
        });

        const form = document.getElementById('studentForm');
        const errorAlert = document.getElementById('errorAlert');
        const successAlert = document.getElementById('successAlert');

        form.addEventListener('submit', async (e) => {
            e.preventDefault();
            
            // Clear old alerts
            errorAlert.style.display = 'none';
            successAlert.style.display = 'none';

            // Gather selected shifts
            const selectedShifts = Array.from(document.querySelectorAll('input[name="shifts"]:checked'))
                                         .map(cb => cb.value);

            if (selectedShifts.length === 0) {
                errorAlert.textContent = "Please select at least one shift.";
                errorAlert.style.display = 'block';
                return;
            }

            const payload = {
                name: document.getElementById('name').value,
                phone: document.getElementById('phone').value,
                seatNumber: parseInt(document.getElementById('seatNumber').value, 10),
                shifts: selectedShifts,
                monthlyFee: parseFloat(document.getElementById('monthlyFee').value) || 0,
                feePaid: document.getElementById('feePaid').checked
            };

            try {
                // Post payload to your register route
                const response = await fetch('/admin/register', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(payload)
                });

                const data = await response.json();

                if (response.ok) {
                    successAlert.textContent = data.message || "Student registered successfully!";
                    successAlert.style.display = 'block';
                    form.reset();
                    // Remove active style from check labels
                    labels.forEach(label => label.classList.remove('selected'));
                } else {
                    errorAlert.textContent = data.error || "Failed to register student.";
                    errorAlert.style.display = 'block';
                }
            } catch (err) {
                errorAlert.textContent = "A connection error occurred. Please try again.";
                errorAlert.style.display = 'block';
            }
        });
    </script>
</body>
</html>