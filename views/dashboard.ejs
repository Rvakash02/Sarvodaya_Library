<!DOCTYPE html>
<html lang="en">
<%- include('./partials/head.ejs') %>
<style>
    /* Alias old variables to new design tokens */
    :root {
        --primary: var(--brand);
        --primary-hover: var(--brand-hover);
        --text-main: var(--fg);
        --text-muted: var(--fg-muted);
        --ink: var(--fg);
        --muted: var(--fg-muted);
        --line: var(--border);
        --soft: var(--bg-subtle);
        --error: #ef4444;
        --success: #10b981;
    }

    /* Interactive 43 Seat Grid Matrix */
    .seat-matrix-card {
        background: var(--bg-elevated, #ffffff);
        border: 1.5px solid var(--border, #e2e8f0);
        border-radius: var(--r-lg, 14px);
        padding: 20px 22px;
        margin-top: 18px;
        margin-bottom: 22px;
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.03);
    }
    .seat-matrix-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 12px;
        margin-bottom: 14px;
        padding-bottom: 14px;
        border-bottom: 1px solid var(--border, #e2e8f0);
    }
    .seat-matrix-title {
        font-family: 'DM Serif Display', Georgia, serif;
        font-size: 20px;
        color: var(--fg, #0f172a);
        margin: 0 0 2px 0;
    }
    .seat-legend-bar {
        display: flex;
        align-items: center;
        gap: 14px;
        font-size: 12.5px;
        font-weight: 600;
        flex-wrap: wrap;
    }
    .legend-item {
        display: flex;
        align-items: center;
        gap: 6px;
    }
    .legend-dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
    }
    .legend-dot.paid { background: #10b981; box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.18); }
    .legend-dot.unpaid { background: #ef4444; box-shadow: 0 0 0 3px rgba(239, 68, 68, 0.18); }
    .legend-dot.vacant { background: #94a3b8; box-shadow: 0 0 0 3px rgba(148, 163, 184, 0.18); }

    .seat-grid-container {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(88px, 1fr));
        gap: 10px;
        margin-top: 14px;
        transition: all 0.3s ease;
    }
    .seat-tile {
        border-radius: 12px;
        padding: 10px 6px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        cursor: pointer;
        user-select: none;
        transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
        position: relative;
        border: 1.5px solid transparent;
        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.03);
    }
    .seat-tile:hover {
        transform: translateY(-3px) scale(1.03);
        box-shadow: 0 8px 18px rgba(0, 0, 0, 0.08);
    }
    .seat-tile:active {
        transform: translateY(0) scale(0.97);
    }
    .seat-tile.seat-paid {
        background: #ecfdf5;
        border-color: #a7f3d0;
        color: #065f46;
    }
    .seat-tile.seat-paid .seat-num-badge {
        background: #10b981;
        color: white;
    }
    .seat-tile.seat-unpaid {
        background: #fef2f2;
        border-color: #fecaca;
        color: #991b1b;
    }
    .seat-tile.seat-unpaid .seat-num-badge {
        background: #ef4444;
        color: white;
    }
    .seat-tile.seat-vacant {
        background: #f8fafc;
        border-color: #e2e8f0;
        color: #64748b;
    }
    .seat-tile.seat-vacant .seat-num-badge {
        background: #94a3b8;
        color: white;
    }
    .seat-num-badge {
        font-size: 11px;
        font-weight: 800;
        padding: 2px 7px;
        border-radius: 20px;
        margin-bottom: 4px;
        letter-spacing: 0.5px;
    }
    .seat-student-name {
        font-size: 11.5px;
        font-weight: 700;
        max-width: 78px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        line-height: 1.2;
    }
    .seat-status-sub {
        font-size: 9.5px;
        font-weight: 600;
        margin-top: 3px;
        opacity: 0.85;
    }
</style>

<body>
    <%- include('./partials/nav.ejs') %>

    <div class="container" style="padding-top: 8px; padding-bottom: 60px;">

        <!-- Sub-nav switcher -->
        <div class="dash-switcher">
            <a href="/admin/dashboard">← Overview</a>
            <a href="/admin/dashboard/library" class="active">📚 Library</a>
            <a href="/admin/dashboard/coaching">🎓 Coaching</a>
        </div>

        <!-- Page header -->
        <div class="dashboard-header">
            <h1 class="dashboard-title">Library students</h1>
            <div class="dashboard-controls">
                <div class="search-box">
                    <input type="text" id="searchInput" placeholder="Search name or phone…" onkeyup="if(event.key==='Enter') triggerSearch()">
                    <button onclick="triggerSearch()">Search</button>
                </div>
                <a href="/admin/analytics/library" class="btn btn-secondary" style="font-weight:700; display:inline-flex; align-items:center; gap:6px; text-decoration:none;">📊 Revenue Analytics</a>
                <a href="/admin/register" class="btn btn-primary">+ Add student</a>
            </div>
        </div>

        <!-- WhatsApp widget -->
        <div class="wa-widget" id="whatsappWidget">
            <div class="wa-status-row">
                <div class="wa-dot" id="whatsappDot"></div>
                <div class="wa-info">
                    <h3>WhatsApp Notifications</h3>
                    <p id="whatsappStatusText">Checking connection…</p>
                </div>
            </div>
            <div id="whatsappActionArea"></div>
        </div>

        <!-- Filters bar -->
        <div class="filters-bar">
            <div class="filter-group">
                <label for="shiftSelect">Shift</label>
                <select id="shiftSelect">
                    <option value="">All shifts…</option>
                    <option value="6am-10am">6 AM – 10 AM</option>
                    <option value="10am-2pm">10 AM – 2 PM</option>
                    <option value="2pm-6pm">2 PM – 6 PM</option>
                    <option value="6pm-10pm">6 PM – 10 PM</option>
                    <option value="night">Night</option>
                </select>
            </div>
            <div class="filter-group">
                <label for="statusSelect">Fee Status</label>
                <select id="statusSelect">
                    <option value="all">All students</option>
                    <option value="paid">Paid</option>
                    <option value="unpaid">Unpaid</option>
                    <option value="vacant">Vacant seats</option>
                </select>
            </div>
            <button onclick="fetchDashboard()" class="btn btn-primary" style="align-self:flex-end;">Apply</button>
        </div>

        <!-- Interactive 43 Seat Grid Matrix -->
        <div class="seat-matrix-card" id="seatMatrixCard">
            <div class="seat-matrix-header">
                <div>
                    <h2 class="seat-matrix-title">
                        🗺️ Seat Layout Map (Seats 1 – 43)
                    </h2>
                    <span style="font-size:12.5px; color:var(--fg-muted);" id="seatMatrixSub">
                        Click any occupied seat for details or a vacant seat to register.
                    </span>
                </div>

                <div class="seat-legend-bar">
                    <div class="legend-item"><span class="legend-dot paid"></span> Paid (<span id="countPaid">0</span>)</div>
                    <div class="legend-item"><span class="legend-dot unpaid"></span> Overdue (<span id="countUnpaid">0</span>)</div>
                    <div class="legend-item"><span class="legend-dot vacant"></span> Vacant (<span id="countVacant">43</span>)</div>
                    <button onclick="toggleSeatMatrix()" class="btn btn-secondary btn-sm" id="toggleMatrixBtn" style="padding:5px 12px; font-size:11.5px; border-radius:6px; font-weight:600; cursor:pointer;">
                        👁️ Collapse
                    </button>
                </div>
            </div>

            <div class="seat-grid-container" id="seatGridContainer">
                <!-- 43 Seats rendered dynamically -->
            </div>
        </div>

        <div id="resultsContainer"></div>
    </div>

    <!-- Student Detail Modal -->
    <div id="studentModal" class="modal-overlay" onclick="closeStudentModal(event)">
        <div class="modal-content" onclick="event.stopPropagation()">
            <button class="close-btn" onclick="closeStudentModal()">&times;</button>
            
            <!-- VIEW MODE PANEL -->
            <div id="modalViewMode">
                <div id="modalSeatBadge" class="status-badge" style="margin-bottom: 10px;"></div>
                <div class="modal-title" id="modalStudentName">Student Name</div>
                
                <div class="detail-row">
                    <span class="detail-label">Phone Number</span>
                    <span class="detail-value" id="modalPhone">-</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Shifts Enrolled</span>
                    <span class="detail-value" id="modalShifts">-</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Monthly Fee</span>
                    <span class="detail-value" id="modalMonthlyFee">₹0</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Admission Date</span>
                    <span class="detail-value" id="modalAdmission">-</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Fee Expiry Date</span>
                    <span class="detail-value" id="modalExpiry">-</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Payment Status</span>
                    <span class="detail-value" id="modalStatus">-</span>
                </div>

                <div style="display: flex; gap: 10px; margin-top: 20px; flex-wrap: wrap;">
                    <!-- Edit Button -->
                    <button onclick="toggleEditMode(true)" style="flex: 1; padding: 10px; background-color: #6366f1; color: white; border: none; border-radius: 8px; font-weight: 600; cursor: pointer; margin-top: 0;">
                        Edit Info
                    </button>
                    <!-- Renew Fee Button -->
                    <button id="modalRenewBtn" class="renew-btn" style="flex: 1.2; margin-top: 0; padding: 10px;">
                        Renew (30 Days)
                    </button>
                    <!-- Send Fee Reminder (only visible when unpaid) -->
                    <button id="modalReminderBtn" onclick="sendFeeReminder()" style="display: none; flex: 1.2; padding: 10px; background-color: #25d366; color: white; border: none; border-radius: 8px; font-weight: 600; cursor: pointer; margin-top: 0; font-size: 13px;">
                        📩 Send Reminder
                    </button>
                </div>
            </div>

            <!-- EDIT MODE PANEL (Hidden by Default) -->
            <div id="modalEditMode" style="display: none;">
                <div class="modal-title" style="font-size: 20px; margin-bottom: 15px;">Edit Student Info</div>
                <form id="editStudentForm" onsubmit="saveStudentEdits(event)" style="padding: 0; border: none; box-shadow: none; margin: 0; max-width: 100%;">
                    <input type="hidden" id="editStudentId">
                    
                    <div class="form-group" style="margin-bottom: 12px;">
                        <label style="font-size: 13px; font-weight: 600; margin-bottom: 4px;">Full Name</label>
                        <input type="text" id="editName" required>
                    </div>
                    
                    <div class="form-group" style="margin-bottom: 12px;">
                        <label style="font-size: 13px; font-weight: 600; margin-bottom: 4px;">Phone Number</label>
                        <input type="tel" id="editPhone" required>
                    </div>

                    <div class="form-group" style="margin-bottom: 12px;">
                        <label style="font-size: 13px; font-weight: 600; margin-bottom: 4px;">Seat Number (1 to 43)</label>
                        <input type="number" id="editSeat" min="1" max="43" required>
                    </div>

                    <div class="form-group" style="margin-bottom: 14px;">
                        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom: 6px;">
                            <label style="font-size: 13px; font-weight: 600; margin: 0;">Select Shifts (Select multiple)</label>
                            <button type="button" onclick="selectAllEditShifts()" style="background:none; border:none; color:var(--brand); font-size:12px; font-weight:600; cursor:pointer; padding:0;">Select All / Clear</button>
                        </div>
                        <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 8px; margin-top: 4px;">
                            <label class="shift-pill"><input type="checkbox" name="editShifts" value="6am-10am"> 6 AM – 10 AM</label>
                            <label class="shift-pill"><input type="checkbox" name="editShifts" value="10am-2pm"> 10 AM – 2 PM</label>
                            <label class="shift-pill"><input type="checkbox" name="editShifts" value="2pm-6pm"> 2 PM – 6 PM</label>
                            <label class="shift-pill"><input type="checkbox" name="editShifts" value="6pm-10pm"> 6 PM – 10 PM</label>
                            <label class="shift-pill" style="grid-column: span 2;"><input type="checkbox" name="editShifts" value="night"> Night shift (10 PM onwards)</label>
                        </div>
                    </div>

                    <div class="form-group" style="margin-bottom: 12px;">
                        <label style="font-size: 13px; font-weight: 600; margin-bottom: 4px;">Monthly Fee / Amount (₹)</label>
                        <input type="number" id="editMonthlyFee" min="0" required placeholder="e.g. 500">
                    </div>

                    <div class="form-group" style="margin-bottom: 14px;">
                        <div style="display:flex; align-items:center; justify-content:space-between; background:var(--bg-subtle); border:1px solid var(--border); border-radius:var(--r-md); padding:12px 14px;">
                            <span style="font-size: 13.5px; font-weight: 600; color: var(--fg);">Fee paid</span>
                            <label class="switch" style="margin:0;">
                                <input type="checkbox" id="editFeePaid" name="feePaid" value="true">
                                <span class="slider"></span>
                            </label>
                        </div>
                    </div>

                    <div class="form-group" style="margin-bottom: 12px;">
                        <label style="font-size: 13px; font-weight: 600; margin-bottom: 4px;">Fee Expiration Date</label>
                        <input type="date" id="editExpiry" required>
                    </div>

                    <div style="display: flex; gap: 10px; margin-top: 18px;">
                        <button type="button" onclick="toggleEditMode(false)" style="flex: 1; padding: 10px; background-color: #cbd5e1; color: #475569; border: none; border-radius: 8px; font-weight: 600; cursor: pointer; margin-top: 0; width: auto; min-height: 40px;">
                            Cancel
                        </button>
                        <button type="submit" style="flex: 1.2; padding: 10px; background-color: #10b981; color: white; border: none; border-radius: 8px; font-weight: 600; cursor: pointer; margin-top: 0; width: auto; min-height: 40px;">
                            Save Changes
                        </button>
                    </div>
                    <button type="button" onclick="deleteStudentData()" style="width: 100%; padding: 12px; background-color: #ef4444; color: white; border: none; border-radius: 8px; font-weight: 700; cursor: pointer; margin-top: 14px; min-height: 42px; font-size: 14px; box-shadow: 0 2px 4px rgba(239, 68, 68, 0.2);">
                        🗑️ Delete Student
                    </button>
                </form>
            </div>
        </div>
    </div>

    <!-- Custom Confirmation Modal -->
    <div id="confirmModal" class="modal-overlay" style="z-index: 1100;">
        <div class="modal-content" style="max-width: 360px; text-align: center; padding: 24px;">
            <div id="confirmModalTitle" style="font-size: 18px; font-weight: 700; color: var(--text-main); margin-bottom: 12px;">Confirm Action</div>
            <p id="confirmModalMessage" style="font-size: 14px; color: var(--text-muted); margin-bottom: 20px; line-height: 1.5;">Are you sure you want to proceed?</p>
            <div style="display: flex; gap: 12px; margin-top: 15px;">
                <button id="confirmNoBtn" type="button" style="flex: 1; padding: 10px; background-color: #cbd5e1; color: #475569; border: none; border-radius: 8px; font-weight: 600; cursor: pointer; margin-top: 0;">No</button>
                <button id="confirmYesBtn" type="button" style="flex: 1; padding: 10px; background-color: var(--primary); color: white; border: none; border-radius: 8px; font-weight: 600; cursor: pointer; margin-top: 0;">Yes</button>
            </div>
        </div>
    </div>

    <!-- Custom Alert Modal -->
    <div id="alertModal" class="modal-overlay" style="z-index: 1200;">
        <div class="modal-content" style="max-width: 360px; text-align: center; padding: 24px;">
            <div id="alertModalTitle" style="font-size: 18px; font-weight: 700; color: var(--text-main); margin-bottom: 12px;">Notification</div>
            <p id="alertModalMessage" style="font-size: 14px; color: var(--text-muted); margin-bottom: 20px; line-height: 1.5;">Message</p>
            <button id="alertOkBtn" type="button" style="width: 100%; padding: 10px; background-color: var(--primary); color: white; border: none; border-radius: 8px; font-weight: 600; cursor: pointer; margin-top: 15px;">OK</button>
        </div>
    </div>

        <script>
        function toggleManualMsg() {
            const panel = document.getElementById('manualMsgPanel');
            const btn = document.getElementById('manualMsgToggleBtn');
            if (panel.style.display === 'none') {
                panel.style.display = 'block';
                btn.style.background = 'var(--ink)';
                btn.style.color = 'var(--bg)';
            } else {
                panel.style.display = 'none';
                btn.style.background = 'var(--bg)';
                btn.style.color = 'var(--ink)';
            }
        }

        async function sendManualWhatsApp() {
            const phone = document.getElementById('waPhone').value.trim();
            const message = document.getElementById('waMessage').value.trim();
            const statusEl = document.getElementById('waSendStatus');
            const sendBtn = document.getElementById('waSendBtn');

            if (!phone || !message) {
                statusEl.textContent = '⚠ Please enter both phone number and message.';
                statusEl.style.color = '#f59e0b';
                return;
            }

            sendBtn.disabled = true;
            sendBtn.textContent = 'Sending...';
            statusEl.textContent = '';

            try {
                const response = await fetch('/admin/send-whatsapp', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ phone, message })
                });
                const data = await response.json();

                if (response.ok) {
                    statusEl.textContent = '✓ Message sent successfully!';
                    statusEl.style.color = '#10b981';
                    document.getElementById('waPhone').value = '';
                    document.getElementById('waMessage').value = '';
                } else {
                    statusEl.textContent = '✗ ' + (data.error || 'Failed to send message.');
                    statusEl.style.color = '#ef4444';
                }
            } catch (err) {
                statusEl.textContent = '✗ Network error. Could not send message.';
                statusEl.style.color = '#ef4444';
            } finally {
                sendBtn.disabled = false;
                sendBtn.textContent = 'Send ➤';
            }
        }

        async function sendFeeReminder() {
            const student = window.selectedStudent;
            if (!student) return;

            const btn = document.getElementById('modalReminderBtn');
            btn.disabled = true;
            btn.textContent = 'Sending...';

            const expiryStr = student.feeExpireDate ? new Date(student.feeExpireDate).toLocaleDateString('en-IN', {
                day: 'numeric', month: 'short', year: 'numeric'
            }) : 'N/A';
            const shiftsStr = student.shifts.join(', ');
            const message = `Dear ${student.name},\n\nThis is a reminder from Sarvodaya Library.\n\nYour fee for Seat ${student.seatNumber} (${shiftsStr}) is UNPAID (expired on ${expiryStr}).\n\nPlease renew your fee at the earliest to continue using your seat.\n\nThank you!`;

            try {
                const response = await fetch('/admin/send-whatsapp', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ phone: student.phone, message })
                });
                const data = await response.json();

                if (response.ok) {
                    btn.textContent = '✓ Sent!';
                    btn.style.backgroundColor = '#10b981';
                    setTimeout(() => {
                        btn.textContent = '📩 Send Reminder';
                        btn.style.backgroundColor = '#25d366';
                        btn.disabled = false;
                    }, 2000);
                } else {
                    await showCustomAlert('Reminder Failed', data.error || 'Could not send reminder. Make sure WhatsApp is connected.');
                    btn.textContent = '📩 Send Reminder';
                    btn.disabled = false;
                }
            } catch (err) {
                await showCustomAlert('Network Error', 'Could not send reminder. Check your connection.');
                btn.textContent = '📩 Send Reminder';
                btn.disabled = false;
            }
        }

        async function triggerSearch() {
            const search = document.getElementById('searchInput').value.trim();
            const resultsContainer = document.getElementById('resultsContainer');
            if (!search) {
                await showCustomAlert("Search Input Needed", "Please enter a name or phone number to search.");
                return;
            }
            resultsContainer.innerHTML = "<p>Searching...</p>";
            try {
                const response = await fetch(`/admin/dashboard-data?search=${encodeURIComponent(search)}`);
                const data = await response.json();
                if (!response.ok) {
                    resultsContainer.innerHTML = `<p style="color:red;">Error: ${data.error}</p>`;
                    return;
                }
                renderStudentCards(data.students || []);
            } catch (err) {
                console.error(err);
                resultsContainer.innerHTML = "<p style='color:red;'>Failed to load search results.</p>";
            }
        }

        async function checkWhatsAppStatus() {
            try {
                const response = await fetch('/admin/whatsapp-status');
                const data = await response.json();
                
                const dot = document.getElementById('whatsappDot');
                const statusText = document.getElementById('whatsappStatusText');
                const actionArea = document.getElementById('whatsappActionArea');
                
                if (!dot || !statusText || !actionArea) return;

                if (data.status === 'READY') {
                    window.whatsappStatus = 'READY';
                    dot.classList.add('connected');
                    dot.classList.remove('qr', 'disconnected');
                    statusText.textContent = 'Connected — automated reminders are active.';
                    actionArea.innerHTML = `
                        <button onclick="triggerUnlinkWhatsApp()" class="btn btn-secondary btn-sm" style="padding:6px 12px; font-size:11.5px; border-radius:6px; cursor:pointer; font-weight:600;">
                            🔓 Unlink WhatsApp Session
                        </button>
                    `;
                    const container = document.getElementById('waModalQrContainer');
                    if (container && document.getElementById('whatsappQrModal').style.display === 'flex') {
                        container.innerHTML = '<p style="color:#059669; font-weight:700; font-size:15px; margin:20px 0;">✅ WhatsApp Linked & Connected Successfully!</p>';
                    }
                } else if (data.status === 'QR' && data.qr) {
                    window.whatsappStatus = 'QR';
                    dot.classList.add('qr');
                    dot.classList.remove('connected', 'disconnected');
                    statusText.textContent = 'Scan QR code below with WhatsApp app on your phone:';
                    actionArea.innerHTML = `
                        <div style="background:var(--bg-elevated); border:2px solid var(--amber); border-radius:12px; padding:16px; display:flex; flex-direction:column; align-items:center; text-align:center; gap:10px; margin-top:8px; width:100%; box-shadow:0 4px 12px rgba(217,119,6,0.12);">
                            <span style="font-size:13px; font-weight:800; color:#b45309; text-transform:uppercase; letter-spacing:0.5px;">
                                📲 Scan with WhatsApp to Link
                            </span>
                            <img src="${data.qr}" alt="WhatsApp QR Code" style="width:210px; height:210px; border-radius:10px; border:2px solid var(--border); background:white; padding:6px; cursor:pointer;" onclick="openWaQrModal()">
                            <p style="font-size:12px; color:var(--fg-muted); margin:0;">Open WhatsApp → Linked Devices → Link a Device</p>
                            <div style="display:flex; gap:8px; margin-top:4px;">
                                <button onclick="openWaQrModal()" class="btn btn-primary btn-sm" style="padding:5px 10px; font-size:11.5px; font-weight:700;">
                                    🔍 Large View
                                </button>
                                <button onclick="triggerUnlinkWhatsApp()" class="btn btn-secondary btn-sm" style="padding:5px 10px; font-size:11.5px; font-weight:700; color:var(--red);">
                                    🔄 Unlink & Refresh QR
                                </button>
                            </div>
                        </div>
                    `;
                    const container = document.getElementById('waModalQrContainer');
                    if (container) {
                        container.innerHTML = `
                            <img src="${data.qr}" alt="WhatsApp QR Code" style="width:220px; height:220px; border-radius:10px; border:2px solid var(--border); background:white; padding:6px;">
                            <span style="font-size:11.5px; color:var(--fg-muted); font-weight:700; text-transform:uppercase;">Scan with WhatsApp app on phone</span>
                        `;
                    }
                } else if (data.status === 'CONNECTING') {
                    window.whatsappStatus = 'CONNECTING';
                    dot.style.backgroundColor = '#3b82f6';
                    statusText.textContent = 'Initializing WhatsApp client — generating QR code…';
                    actionArea.innerHTML = `
                        <div style="background:var(--brand-faint); border:1.5px solid var(--brand-light); border-radius:10px; padding:14px; text-align:center; margin-top:8px; width:100%;">
                            <p style="color:var(--brand); font-size:13px; font-weight:700; margin:0;">
                                ⏳ Starting browser... Generating QR Code... Please wait 5-10 seconds.
                            </p>
                        </div>
                    `;
                    const container = document.getElementById('waModalQrContainer');
                    if (container && document.getElementById('whatsappQrModal').style.display === 'flex') {
                        container.innerHTML = '<p style="font-size:13px; color:var(--brand); font-weight:600; margin:20px 0;">⏳ Launching browser and generating QR code... Please wait.</p>';
                    }
                } else {
                    window.whatsappStatus = 'DISCONNECTED';
                    dot.classList.add('disconnected');
                    dot.classList.remove('connected', 'qr');
                    statusText.textContent = 'WhatsApp is disconnected. Click below to unlink and show QR code.';
                    actionArea.innerHTML = `
                        <button onclick="reconnectWhatsAppClient(event)" class="btn btn-primary" style="width:100%; padding:12px; font-size:13.5px; font-weight:700; border-radius:8px; cursor:pointer; margin-top:8px;">
                            📷 Show QR Code / Unlink WhatsApp
                        </button>
                    `;
                }
            } catch (err) {
                console.error('Error polling WhatsApp status:', err);
            }
        }

        function openWaQrModal() {
            document.getElementById('whatsappQrModal').style.display = 'flex';
        }

        function closeWaQrModal() {
            document.getElementById('whatsappQrModal').style.display = 'none';
        }

        async function triggerUnlinkWhatsApp() {
            const container = document.getElementById('waModalQrContainer');
            if (container) {
                container.innerHTML = '<p style="font-size:13px; color:var(--brand); font-weight:600;">Unlinking previous session & generating QR code...</p>';
            }
            try {
                await fetch('/admin/whatsapp-reconnect', { method: 'POST' });
                pollForQr();
            } catch (err) {
                if (container) container.innerHTML = '<p style="color:red; font-size:13px;">Failed to trigger reconnect.</p>';
            }
        }

        async function reconnectWhatsAppClient(e) {
            if (e) e.preventDefault();
            openWaQrModal();
            triggerUnlinkWhatsApp();
        }

        function pollForQr() {
            let count = 0;
            const interval = setInterval(async () => {
                count++;
                await checkWhatsAppStatus();
                if (window.whatsappStatus === 'QR' || window.whatsappStatus === 'READY' || count > 15) {
                    clearInterval(interval);
                }
            }, 1500);
        }

        // Attach key listener to Search Input and start polling WhatsApp status
        document.addEventListener('DOMContentLoaded', () => {
            const searchInput = document.getElementById('searchInput');
            if (searchInput) {
                searchInput.addEventListener('keypress', function(e) {
                    if (e.key === 'Enter') {
                        triggerSearch();
                    }
                });
            }

            // Load initial student list (all shifts, all students)
            fetchDashboard();
            
            // Poll WhatsApp status
            checkWhatsAppStatus();
            setInterval(checkWhatsAppStatus, 5000);
        });

        function renderStudentCards(students) {
            const resultsContainer = document.getElementById('resultsContainer');
            if (!students || students.length === 0) {
                resultsContainer.innerHTML = `
                    <div class="empty-state">
                        <div class="empty-icon">🔍</div>
                        <h3>No students found</h3>
                        <p>Try adjusting the filter or search term.</p>
                        <a href="/admin/register" class="btn btn-primary">+ Add a student</a>
                    </div>
                `;
                return;
            }

            // Sort students serially by seat number
            students.sort((a, b) => Number(a.seatNumber || 0) - Number(b.seatNumber || 0));

            // Store current student lists globally to look them up on click
            window.currentStudents = students;

            let html = `
                <div style="margin-bottom: 14px; font-size: 14px; font-weight: 600; color: var(--fg-muted);">
                    Total results: <span style="color: var(--fg); font-weight: 700;">${students.length}</span> student${students.length === 1 ? '' : 's'}
                </div>
                <div class="student-grid">
            `;
            students.forEach((student, index) => {
                const isPaid = student.feePaid;
                const expiryStr = student.feeExpireDate ? new Date(student.feeExpireDate).toLocaleDateString('en-IN', {
                    day: 'numeric',
                    month: 'short',
                    year: 'numeric'
                }) : 'N/A';

                html += `
                    <div class="student-card" onclick="openStudentModal(${index})">
                        <span class="seat-badge">Seat ${student.seatNumber}</span>
                        <div class="student-name">${student.name}</div>
                        <div class="expiry-info">
                            <strong>Fee:</strong> ₹${(student.monthlyFee || 0).toLocaleString('en-IN')}<br>
                            <strong>Expires:</strong> ${expiryStr}
                        </div>
                        <span class="status-badge ${isPaid ? 'status-paid' : 'status-unpaid'}">
                            ${isPaid ? 'PAID' : 'UNPAID'}
                        </span>
                    </div>
                `;
            });
            html += `</div>`;
            resultsContainer.innerHTML = html;
        }

        async function fetchDashboard() {
            const shiftSelect = document.getElementById('shiftSelect');
            const shift = shiftSelect ? shiftSelect.value : '';
            const status = document.getElementById('statusSelect').value;
            const search = document.getElementById('searchInput').value.trim();
            const resultsContainer = document.getElementById('resultsContainer');
            
            resultsContainer.innerHTML = "<p style='padding:20px; color:var(--fg-muted);'>Loading...</p>";
            try {
                const response = await fetch(`/admin/dashboard-data?shift=${encodeURIComponent(shift)}&status=${status}&search=${encodeURIComponent(search)}`);
                const data = await response.json();
                if (!response.ok) {
                    resultsContainer.innerHTML = `<p style="color:red;">Error: ${data.error || 'Failed to load data'}</p>`;
                    return;
                }
                if (status === 'vacant') {
                    // Render vacant seats in a grid layout
                    if (data.vacantSeats.length === 0) {
                        resultsContainer.innerHTML = "<p>No vacant seats left for this shift!</p>";
                    } else {
                        let html = `<h3>Vacant Seats (${data.vacantSeats.length} available):</h3><div class="vacant-grid">`;
                        data.vacantSeats.forEach(seat => {
                            html += `<div class="seat">Seat ${seat}</div>`;
                        });
                        html += `</div>`;
                        resultsContainer.innerHTML = html;
                    }
                } else {
                    renderStudentCards(data.students || []);
                }

                // Synchronize Interactive 43 Seat Grid Matrix
                if (status === 'all' && !search) {
                    renderSeatMatrix(data.students || []);
                } else {
                    fetch(`/admin/dashboard-data?shift=${encodeURIComponent(shift)}&status=all`)
                        .then(res => res.json())
                        .then(allData => renderSeatMatrix(allData.students || []))
                        .catch(() => renderSeatMatrix(data.students || []));
                }
            } catch (err) {
                resultsContainer.innerHTML = `<p style="color:red;">Failed to retrieve data.</p>`;
            }
        }

        // --- INTERACTIVE 43 SEAT GRID MATRIX LOGIC ---
        function renderSeatMatrix(students) {
            const container = document.getElementById('seatGridContainer');
            if (!container) return;

            if (students) {
                window.seatMatrixStudents = students;
            } else {
                students = window.seatMatrixStudents || [];
            }

            const seatMap = {};
            students.forEach(s => {
                if (s && s.seatNumber) {
                    seatMap[s.seatNumber] = s;
                }
            });

            let paidCount = 0;
            let unpaidCount = 0;
            let vacantCount = 0;

            let html = '';

            for (let i = 1; i <= 43; i++) {
                const student = seatMap[i];
                if (student) {
                    const isPaid = student.feePaid;
                    if (isPaid) paidCount++;
                    else unpaidCount++;

                    html += `
                        <div class="seat-tile ${isPaid ? 'seat-paid' : 'seat-unpaid'}" 
                             onclick="handleSeatClick(${i})"
                             title="Seat ${i}: ${student.name} (${isPaid ? 'Paid' : 'Unpaid'})">
                            <span class="seat-num-badge">#${i}</span>
                            <span class="seat-student-name">${student.name}</span>
                            <span class="seat-status-sub">${isPaid ? '🟢 Paid' : '🔴 Overdue'}</span>
                        </div>
                    `;
                } else {
                    vacantCount++;
                    html += `
                        <div class="seat-tile seat-vacant" 
                             onclick="handleVacantClick(${i})"
                             title="Seat ${i}: Vacant — Click to Register">
                            <span class="seat-num-badge">#${i}</span>
                            <span class="seat-student-name" style="color:var(--fg-muted);">Vacant</span>
                            <span class="seat-status-sub" style="color:var(--fg-muted);">+ Register</span>
                        </div>
                    `;
                }
            }

            container.innerHTML = html;

            const pEl = document.getElementById('countPaid');
            const uEl = document.getElementById('countUnpaid');
            const vEl = document.getElementById('countVacant');
            if (pEl) pEl.textContent = paidCount;
            if (uEl) uEl.textContent = unpaidCount;
            if (vEl) vEl.textContent = vacantCount;
        }

        function handleSeatClick(seatNum) {
            const allStudents = window.seatMatrixStudents || window.currentStudents || [];
            const student = allStudents.find(s => Number(s.seatNumber) === Number(seatNum));
            if (student) {
                if (!window.currentStudents) window.currentStudents = [];
                let idx = window.currentStudents.findIndex(s => s._id === student._id);
                if (idx < 0) {
                    window.currentStudents.push(student);
                    idx = window.currentStudents.length - 1;
                }
                openStudentModal(idx);
            }
        }

        function handleVacantClick(seatNum) {
            openVacantModal(seatNum);
        }

        function openVacantModal(seatNum) {
            const titleEl = document.getElementById('vacantSeatTitle');
            const msgEl = document.getElementById('vacantSeatMessage');
            const btnEl = document.getElementById('vacantRegisterBtn');
            if (titleEl) titleEl.textContent = `Seat #${seatNum} is Available`;
            if (msgEl) msgEl.textContent = `Seat #${seatNum} is currently vacant. Would you like to register a new student for this seat?`;
            if (btnEl) {
                btnEl.onclick = () => {
                    window.location.href = `/admin/register?seatNumber=${seatNum}`;
                };
            }
            const modal = document.getElementById('vacantSeatModal');
            if (modal) modal.style.display = 'flex';
        }

        function closeVacantModal() {
            const modal = document.getElementById('vacantSeatModal');
            if (modal) modal.style.display = 'none';
        }

        function toggleSeatMatrix() {
            const grid = document.getElementById('seatGridContainer');
            const btn = document.getElementById('toggleMatrixBtn');
            if (!grid || !btn) return;
            if (grid.style.display === 'none') {
                grid.style.display = 'grid';
                btn.textContent = '👁️ Collapse';
            } else {
                grid.style.display = 'none';
                btn.textContent = '👁️ Expand Map';
            }
        }

        // Modal functions
        function openStudentModal(index) {
            const student = window.currentStudents[index];
            if (!student) return;

            window.selectedStudent = student; // Store globally for edit toggle reference
            toggleEditMode(false); // Reset to view mode first

            document.getElementById('modalStudentName').textContent = student.name;
            document.getElementById('modalPhone').textContent = student.phone;
            
            // Format Seat Number Badge
            const seatBadge = document.getElementById('modalSeatBadge');
            seatBadge.textContent = `Seat ${student.seatNumber}`;
            seatBadge.className = "status-badge status-paid";

            // Format Shifts
            document.getElementById('modalShifts').textContent = student.shifts.join(', ');
            document.getElementById('modalMonthlyFee').textContent = `₹${(student.monthlyFee || 0).toLocaleString('en-IN')}`;
            
            // Format Dates
            const admissionDate = student.admissionDate ? new Date(student.admissionDate).toLocaleDateString('en-IN') : 'N/A';
            const expireDate = student.feeExpireDate ? new Date(student.feeExpireDate).toLocaleDateString('en-IN') : 'N/A';
            document.getElementById('modalAdmission').textContent = admissionDate;
            document.getElementById('modalExpiry').textContent = expireDate;
            
            // Format Payment Status Row
            const statusVal = document.getElementById('modalStatus');
            statusVal.textContent = student.feePaid ? 'PAID' : 'UNPAID';
            statusVal.className = `detail-value status-badge ${student.feePaid ? 'status-paid' : 'status-unpaid'}`;

            // Configure Renew Button Click
            const renewBtn = document.getElementById('modalRenewBtn');
            renewBtn.onclick = () => renewStudentFee(student._id);

            // Show/hide Send Reminder button based on fee status
            const reminderBtn = document.getElementById('modalReminderBtn');
            if (!student.feePaid) {
                reminderBtn.style.display = 'inline-block';
            } else {
                reminderBtn.style.display = 'none';
            }

            document.getElementById('studentModal').style.display = 'flex';
        }

        function closeStudentModal(event) {
            // Close either clicking the button or clicking the dark background overlay
            document.getElementById('studentModal').style.display = 'none';
        }

        function selectAllEditShifts() {
            const checkboxes = document.querySelectorAll('input[name="editShifts"]');
            const allChecked = Array.from(checkboxes).every(cb => cb.checked);
            checkboxes.forEach(cb => {
                cb.checked = !allChecked;
                const pill = cb.closest('.shift-pill');
                if (pill) {
                    if (cb.checked) pill.classList.add('selected');
                    else pill.classList.remove('selected');
                }
            });
        }

        // Auto-update shift-pill visual state when editing shifts
        document.addEventListener('change', (e) => {
            if (e.target && e.target.name === 'editShifts') {
                const pill = e.target.closest('.shift-pill');
                if (pill) {
                    if (e.target.checked) pill.classList.add('selected');
                    else pill.classList.remove('selected');
                }
            }
        });

        function toggleEditMode(isEdit) {
            const viewPanel = document.getElementById('modalViewMode');
            const editPanel = document.getElementById('modalEditMode');
            const student = window.selectedStudent;

            if (isEdit && student) {
                viewPanel.style.display = 'none';
                editPanel.style.display = 'block';

                // Populate form fields
                document.getElementById('editStudentId').value = student._id;
                document.getElementById('editName').value = student.name;
                document.getElementById('editPhone').value = student.phone;
                document.getElementById('editSeat').value = student.seatNumber;
                document.getElementById('editMonthlyFee').value = student.monthlyFee !== undefined ? student.monthlyFee : 0;

                document.getElementById('editFeePaid').checked = Boolean(student.feePaid);

                // Parse and toggle shift checkboxes & visual pill styling
                const currentShifts = Array.isArray(student.shifts) 
                    ? student.shifts 
                    : (typeof student.shifts === 'string' ? student.shifts.split(',').map(s => s.trim()) : []);

                const checkboxes = document.querySelectorAll('input[name="editShifts"]');
                checkboxes.forEach(cb => {
                    cb.checked = currentShifts.includes(cb.value);
                    const pill = cb.closest('.shift-pill');
                    if (pill) {
                        if (cb.checked) pill.classList.add('selected');
                        else pill.classList.remove('selected');
                    }
                });

                // Format expiry date as YYYY-MM-DD for HTML5 date input
                if (student.feeExpireDate) {
                    const date = new Date(student.feeExpireDate);
                    const yyyy = date.getFullYear();
                    const mm = String(date.getMonth() + 1).padStart(2, '0');
                    const dd = String(date.getDate()).padStart(2, '0');
                    document.getElementById('editExpiry').value = `${yyyy}-${mm}-${dd}`;
                } else {
                    document.getElementById('editExpiry').value = '';
                }
            } else {
                viewPanel.style.display = 'block';
                editPanel.style.display = 'none';
            }
        }

        function showCustomAlert(title, message) {
            return new Promise((resolve) => {
                const modal = document.getElementById('alertModal');
                document.getElementById('alertModalTitle').textContent = title;
                document.getElementById('alertModalMessage').textContent = message;

                const okBtn = document.getElementById('alertOkBtn');
                const handleOk = () => {
                    modal.style.display = 'none';
                    okBtn.removeEventListener('click', handleOk);
                    resolve();
                };

                okBtn.addEventListener('click', handleOk);
                modal.style.display = 'flex';
            });
        }

        function showCustomConfirm(title, message) {
            return new Promise((resolve) => {
                const modal = document.getElementById('confirmModal');
                document.getElementById('confirmModalTitle').textContent = title;
                document.getElementById('confirmModalMessage').textContent = message;

                const yesBtn = document.getElementById('confirmYesBtn');
                const noBtn = document.getElementById('confirmNoBtn');

                const handleYes = () => {
                    cleanup();
                    resolve(true);
                };

                const handleNo = () => {
                    cleanup();
                    resolve(false);
                };

                const cleanup = () => {
                    modal.style.display = 'none';
                    yesBtn.removeEventListener('click', handleYes);
                    noBtn.removeEventListener('click', handleNo);
                };

                yesBtn.addEventListener('click', handleYes);
                noBtn.addEventListener('click', handleNo);

                modal.style.display = 'flex';
            });
        }

        async function saveStudentEdits(event) {
            event.preventDefault();

            const studentId = document.getElementById('editStudentId').value;
            const name = document.getElementById('editName').value;
            const phone = document.getElementById('editPhone').value;
            const seatNumber = parseInt(document.getElementById('editSeat').value, 10);
            const monthlyFee = parseFloat(document.getElementById('editMonthlyFee').value) || 0;
            const feeExpireDate = document.getElementById('editExpiry').value;

            const shifts = Array.from(document.querySelectorAll('input[name="editShifts"]:checked'))
                                .map(cb => cb.value);

            if (shifts.length === 0) {
                await showCustomAlert("Validation Error", "Please select at least one shift.");
                return;
            }

            const feePaid = document.getElementById('editFeePaid').checked;

            const confirmed = await showCustomConfirm("Save Changes?", "Are you sure you want to save these changes to this student?");
            if (!confirmed) return;

            try {
                const response = await fetch('/admin/update-student', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        studentId,
                        name,
                        phone,
                        seatNumber,
                        shifts,
                        monthlyFee,
                        feeExpireDate,
                        feePaid
                    })
                });

                const data = await response.json();
                if (response.ok) {
                    await showCustomAlert("Success", "Student details updated successfully!");
                    closeStudentModal();
                    fetchDashboard(); // Refresh cards list
                } else {
                    await showCustomAlert("Update Failed", data.error || "Failed to update student details.");
                }
            } catch (err) {
                await showCustomAlert("Error", "Connection failed. Could not reach server.");
            }
        }

        async function deleteStudentData() {
            const student = window.selectedStudent;
            const studentId = document.getElementById('editStudentId').value || (student && student._id);
            if (!studentId) return;

            const confirmed = await showCustomConfirm("Delete Student?", "Are you sure you want to delete this student? This action cannot be undone.");
            if (!confirmed) return;

            try {
                const response = await fetch('/admin/delete-student', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ studentId })
                });

                const data = await response.json();
                if (response.ok) {
                    await showCustomAlert("Success", "Student deleted successfully!");
                    closeStudentModal();
                    fetchDashboard(); // Refresh cards list
                } else {
                    await showCustomAlert("Delete Failed", data.error || "Failed to delete student.");
                }
            } catch (err) {
                await showCustomAlert("Error", "Connection failed. Could not reach server.");
            }
        }

        async function renewStudentFee(studentId) {
            const confirmed = await showCustomConfirm("Renew Fee?", "Extend fees for another 30 days from previous expiry date?");
            if (!confirmed) return;
            try {
                const response = await fetch('/admin/renew-fee', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ studentId })
                });

                const data = await response.json();
                if (response.ok) {
                    await showCustomAlert("Success", data.message);
                    closeStudentModal();
                    fetchDashboard(); // Reload current view cards
                } else {
                    await showCustomAlert("Renewal Failed", data.error || "Could not renew fee.");
                }
            } catch (err) {
                await showCustomAlert("Error", "Failed to connect to the server.");
            }
        }
    </script>

    <!-- WhatsApp QR Code Modal -->
    <div id="whatsappQrModal" class="modal-overlay" style="display:none; align-items:center; justify-content:center; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.65); z-index:99999;">
