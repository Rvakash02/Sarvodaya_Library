            <div style="font-size:36px; margin-bottom:8px;">🪑</div>
            <h3 id="vacantSeatTitle" style="font-family:'DM Serif Display', Georgia, serif; font-size:22px; color:var(--fg); margin-bottom:8px;">Seat # -- is Available</h3>
