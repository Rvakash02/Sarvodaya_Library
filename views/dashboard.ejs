            <button onclick="closeWaQrModal()" style="position:absolute; top:12px; right:14px; background:none; border:none; font-size:22px; cursor:pointer; color:var(--fg-muted); font-weight:700;">&times;</button>
            <h3 style="margin-bottom:6px; font-family:'DM Serif Display', Georgia, serif; font-size:22px; color:var(--fg);">WhatsApp Web Link</h3>
