                <button id="vacantRegisterBtn" style="flex:1; padding:10px 12px; font-size:13px; background:var(--brand); color:white; border:none; border-radius:8px; font-weight:700; cursor:pointer;">+ Register</button>
            </div>
        </div>
    </div>

    <!-- Library Financial Analytics Modal -->
    <div id="analyticsModal" class="modal-overlay" style="display:none; align-items:center; justify-content:center; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.65); z-index:99995;">
        <div style="background:var(--bg-elevated); border:1.5px solid var(--border); border-radius:18px; padding:26px; max-width:640px; width:92%; max-height:90vh; overflow-y:auto; box-shadow:0 12px 35px rgba(0,0,0,0.25); position:relative;">
            <button onclick="closeAnalyticsModal()" style="position:absolute; top:14px; right:16px; background:none; border:none; font-size:24px; cursor:pointer; color:var(--fg-muted); font-weight:700;">&times;</button>
            
            <div style="display:flex; align-items:center; gap:10px; margin-bottom:4px;">
                <span style="font-size:24px;">📊</span>
                <h2 id="analyticsTitle" style="font-family:'DM Serif Display', Georgia, serif; font-size:24px; color:var(--fg); margin:0;">Library Financial Analytics</h2>
            </div>
            <p style="font-size:13px; color:var(--fg-muted); margin-bottom:18px;">Detailed revenue breakdown, pending dues, and shift collection data.</p>

            <!-- 4 Quick Stats Cards -->
            <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(125px, 1fr)); gap:12px; margin-bottom:20px;">
                <div style="background:#ecfdf5; border:1px solid #a7f3d0; border-radius:12px; padding:14px; text-align:center;">
                    <span style="font-size:11px; font-weight:700; color:#047857; text-transform:uppercase;">Collected</span>
                    <div id="analyticsPaidRev" style="font-size:19px; font-weight:800; color:#059669; margin-top:2px;">₹0</div>
                </div>
                <div style="background:#fef2f2; border:1px solid #fecaca; border-radius:12px; padding:14px; text-align:center;">
                    <span style="font-size:11px; font-weight:700; color:#b91c1c; text-transform:uppercase;">Pending Dues</span>
                    <div id="analyticsPendingRev" style="font-size:19px; font-weight:800; color:#dc2626; margin-top:2px;">₹0</div>
                </div>
                <div style="background:#eff6ff; border:1px solid #bfdbfe; border-radius:12px; padding:14px; text-align:center;">
                    <span style="font-size:11px; font-weight:700; color:#1d4ed8; text-transform:uppercase;">Target Total</span>
                    <div id="analyticsProjectedRev" style="font-size:19px; font-weight:800; color:#2563eb; margin-top:2px;">₹0</div>
                </div>
                <div style="background:#fef3c7; border:1px solid #fde68a; border-radius:12px; padding:14px; text-align:center;">
                    <span style="font-size:11px; font-weight:700; color:#b45309; text-transform:uppercase;">Collection Rate</span>
                    <div id="analyticsRate" style="font-size:19px; font-weight:800; color:#d97706; margin-top:2px;">0%</div>
                </div>
            </div>

            <!-- Shift Breakdown Table -->
            <div style="margin-bottom:20px; background:var(--bg-subtle); border:1px solid var(--border); border-radius:14px; padding:16px;">
                <h4 style="font-size:14px; font-weight:700; margin:0 0 12px 0; color:var(--fg);">📋 Shift-wise Revenue Breakdown</h4>
                <div id="analyticsBreakdownContainer" style="font-size:13px;">Loading breakdown...</div>
            </div>

            <!-- Trend Chart -->
            <div style="background:var(--bg-subtle); border:1px solid var(--border); border-radius:14px; padding:16px;">
                <h4 style="font-size:14px; font-weight:700; margin:0 0 10px 0; color:var(--fg);">📈 6-Month Library Revenue Trend</h4>
                <div style="height:190px; position:relative;">
                    <canvas id="modalTrendChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        let modalChartInstance = null;

        async function openAnalyticsModal(type = 'library') {
            const modal = document.getElementById('analyticsModal');
            if (modal) modal.style.display = 'flex';

            document.getElementById('analyticsBreakdownContainer').innerHTML = '<p style="color:var(--fg-muted);">Loading live financial data...</p>';

            try {
                const res = await fetch(`/admin/analytics-data?type=${type}`);
                const data = await res.json();

                document.getElementById('analyticsPaidRev').textContent = '₹' + (data.totalPaid || 0).toLocaleString('en-IN');
                document.getElementById('analyticsPendingRev').textContent = '₹' + (data.totalPending || 0).toLocaleString('en-IN');
                document.getElementById('analyticsProjectedRev').textContent = '₹' + (data.totalProjected || 0).toLocaleString('en-IN');
                document.getElementById('analyticsRate').textContent = (data.collectionRate || 0) + '%';

                // Render Shift Breakdown
                if (data.shiftBreakdown) {
                    let html = `
                        <div style="display:flex; flex-direction:column; gap:8px;">
                    `;
                    const shiftLabels = {
                        '6am-10am': '6 AM – 10 AM',
                        '10am-2pm': '10 AM – 2 PM',
                        '2pm-6pm': '2 PM – 6 PM',
                        '6pm-10pm': '6 PM – 10 PM',
                        'night': 'Night Shift'
                    };

                    Object.keys(data.shiftBreakdown).forEach(st => {
                        const info = data.shiftBreakdown[st];
                        const label = shiftLabels[st] || st;
                        html += `
                            <div style="display:flex; justify-content:space-between; align-items:center; background:#ffffff; border:1px solid var(--border); border-radius:8px; padding:8px 12px;">
                                <div>
                                    <strong style="color:var(--fg);">${label}</strong>
                                    <span style="font-size:11.5px; color:var(--fg-muted); margin-left:6px;">(${info.paidCount} paid, ${info.unpaidCount} overdue)</span>
                                </div>
                                <div style="text-align:right;">
                                    <span style="color:#059669; font-weight:700;">₹${info.paidRev.toLocaleString('en-IN')}</span>
                                    <span style="color:#dc2626; font-size:11.5px; margin-left:6px;">(Pending ₹${info.pendingRev.toLocaleString('en-IN')})</span>
                                </div>
                            </div>
                        `;
                    });
                    html += `</div>`;
                    document.getElementById('analyticsBreakdownContainer').innerHTML = html;
                }

                // Render Trend Chart
                const ctx = document.getElementById('modalTrendChart');
                if (ctx) {
                    if (modalChartInstance) modalChartInstance.destroy();
                    modalChartInstance = new Chart(ctx, {
                        type: 'line',
                        data: {
                            labels: data.months || [],
                            datasets: [{
                                label: 'Library Revenue (₹)',
                                data: data.trend || [],
                                borderColor: '#5b4fcf',
                                backgroundColor: 'rgba(91, 79, 207, 0.12)',
                                fill: true,
                                tension: 0.3,
                                pointBackgroundColor: '#5b4fcf',
                                pointRadius: 4
                            }]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            plugins: {
                                legend: { display: false },
                                tooltip: {
                                    callbacks: {
                                        label: function(ctx) { return 'Revenue: ₹' + ctx.raw.toLocaleString('en-IN'); }
                                    }
                                }
                            },
                            scales: {
                                x: { grid: { display: false }, ticks: { font: { family: 'Inter', size: 11 } } },
                                y: { beginAtZero: true, grid: { color: '#e2e8f0' }, ticks: { font: { family: 'Inter', size: 10 }, callback: v => '₹' + v } }
                            }
                        }
                    });
                }

            } catch (err) {
                console.error(err);
                document.getElementById('analyticsBreakdownContainer').innerHTML = '<p style="color:red;">Failed to load analytics data.</p>';
            }
        }

        function closeAnalyticsModal() {
            const modal = document.getElementById('analyticsModal');
            if (modal) modal.style.display = 'none';
        }
    </script>

    <!-- ============================================================
         AI CHATBOT WIDGET
         ============================================================ -->

    <!-- Floating Action Button -->
    <button class="chat-fab" id="chatFab" onclick="toggleChatPanel()" title="AI Seat Assistant">
        <span id="chatFabIcon">🤖</span>
        <span class="chat-fab-badge" id="chatFabBadge"></span>
    </button>

    <!-- Chat Panel -->
    <div class="chat-panel" id="chatPanel">
        <!-- Header -->
        <div class="chat-header">
            <div class="chat-header-icon">🤖</div>
            <div class="chat-header-info">
                <h3>Sarvodaya AI Assistant</h3>
                <p>Seat management &amp; insights</p>
            </div>
        </div>

        <!-- Messages Area -->
        <div class="chat-messages" id="chatMessages">
            <div class="chat-msg chat-msg-bot">
                👋 Hi! I'm your AI assistant. I can help you find vacant seats, suggest rearrangements, check fee status, and more. Try asking me something!
            </div>
        </div>

        <!-- Quick Action Chips -->
        <div class="chat-chips" id="chatChips">
            <button class="chat-chip" onclick="sendChatChip('Find vacant seats for 10am-2pm shift')">🪑 Vacant seats</button>
            <button class="chat-chip" onclick="sendChatChip('List all unpaid students')">💰 Unpaid students</button>
            <button class="chat-chip" onclick="sendChatChip('Show occupancy and revenue stats')">📊 Stats</button>
            <button class="chat-chip" onclick="sendChatChip('Which shift has the most vacant seats?')">📋 Shift demand</button>
        </div>

        <!-- Undo Bar -->
        <div class="chat-undo-bar" id="chatUndoBar">
            <span>⚠️ Action performed</span>
            <button class="chat-undo-btn" onclick="undoChatAction()">↩ Undo</button>
        </div>

        <!-- Input Area -->
        <div class="chat-input-area">
            <input type="text" class="chat-input" id="chatInput" placeholder="Ask about seats, fees, students..." onkeydown="if(event.key==='Enter') sendChatMessage()">
            <button class="chat-send-btn" id="chatSendBtn" onclick="sendChatMessage()">➤</button>
        </div>
    </div>

    <script>
        // --- AI CHATBOT LOGIC ---
        const chatSessionId = 'session_' + Date.now() + '_' + Math.random().toString(36).substr(2, 9);
        let chatOpen = false;
        let chatSending = false;

        function toggleChatPanel() {
            chatOpen = !chatOpen;
            const panel = document.getElementById('chatPanel');
            const fab = document.getElementById('chatFab');
            const fabIcon = document.getElementById('chatFabIcon');
            const badge = document.getElementById('chatFabBadge');

            if (chatOpen) {
                panel.classList.add('visible');
                fab.classList.add('open');
                fabIcon.textContent = '✕';
                badge.style.display = 'none';
                // Focus input
                setTimeout(() => document.getElementById('chatInput').focus(), 350);
            } else {
                panel.classList.remove('visible');
                fab.classList.remove('open');
                fabIcon.textContent = '🤖';
            }
        }

        function addChatMessage(text, sender) {
            const messagesEl = document.getElementById('chatMessages');
            const msgDiv = document.createElement('div');
            msgDiv.className = `chat-msg chat-msg-${sender}`;

            // Basic markdown-like formatting for bot messages
            if (sender === 'bot') {
                let formatted = text
                    .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
                    .replace(/\*(.*?)\*/g, '<em>$1</em>')
                    .replace(/\n/g, '<br>');
                msgDiv.innerHTML = formatted;
            } else {
                msgDiv.textContent = text;
            }

            messagesEl.appendChild(msgDiv);
            messagesEl.scrollTop = messagesEl.scrollHeight;
        }

        function showTypingIndicator() {
            const messagesEl = document.getElementById('chatMessages');
            const typingDiv = document.createElement('div');
            typingDiv.className = 'chat-typing';
            typingDiv.id = 'chatTypingIndicator';
            typingDiv.innerHTML = '<span class="chat-typing-dot"></span><span class="chat-typing-dot"></span><span class="chat-typing-dot"></span>';
            messagesEl.appendChild(typingDiv);
            messagesEl.scrollTop = messagesEl.scrollHeight;
        }

        function removeTypingIndicator() {
            const el = document.getElementById('chatTypingIndicator');
            if (el) el.remove();
        }

        function sendChatChip(message) {
            document.getElementById('chatInput').value = message;
            sendChatMessage();
        }

        async function sendChatMessage() {
            const input = document.getElementById('chatInput');
            const message = input.value.trim();
            if (!message || chatSending) return;

            chatSending = true;
            const sendBtn = document.getElementById('chatSendBtn');
            sendBtn.disabled = true;

            // Show user message
            addChatMessage(message, 'user');
            input.value = '';

            // Hide chips after first message
            const chips = document.getElementById('chatChips');
            if (chips) chips.style.display = 'none';

            // Show typing
            showTypingIndicator();

            try {
                const response = await fetch('/admin/ai-chat', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ message, sessionId: chatSessionId })
                });

                const data = await response.json();
                removeTypingIndicator();

                if (response.ok) {
                    addChatMessage(data.reply || 'No response received.', 'bot');

                    // Show/hide undo bar
                    const undoBar = document.getElementById('chatUndoBar');
                    if (data.canUndo) {
                        undoBar.classList.add('visible');
                    } else {
                        undoBar.classList.remove('visible');
                    }

                    // Refresh dashboard data if bot performed an action
                    if (data.canUndo) {
                        fetchDashboard();
                    }
                } else {
                    addChatMessage('❌ ' + (data.error || 'Something went wrong. Please try again.'), 'bot');
                }
            } catch (err) {
                removeTypingIndicator();
                addChatMessage('❌ Network error. Could not reach the server.', 'bot');
            } finally {
                chatSending = false;
                sendBtn.disabled = false;
                input.focus();
            }
        }

        async function undoChatAction() {
            const undoBar = document.getElementById('chatUndoBar');
            try {
                const response = await fetch('/admin/ai-chat/undo', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ sessionId: chatSessionId })
                });
                const data = await response.json();

                if (data.success) {
                    addChatMessage('↩ ' + data.reply, 'bot');
                    undoBar.classList.remove('visible');
                    fetchDashboard(); // Refresh dashboard
                } else {
                    addChatMessage('⚠️ ' + (data.reply || 'Could not undo.'), 'bot');
                }
            } catch (err) {
                addChatMessage('❌ Failed to undo. Network error.', 'bot');
            }
        }
    </script>
</body>
</html>