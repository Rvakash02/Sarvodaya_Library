<!DOCTYPE html>
<html lang="en">
<%- include('./partials/head.ejs') %>
<body>
    <%- include('./partials/nav.ejs') %>

    <div class="container" style="padding-top: 16px; padding-bottom: 60px; max-width: 1000px;">
        
        <!-- Navigation & Header -->
        <div style="margin-bottom: 24px;">
            <a href="/admin/dashboard/library" class="btn btn-secondary btn-sm" style="margin-bottom: 14px; display:inline-flex; align-items:center; gap:6px;">
                ← Back to Library Dashboard
            </a>
            <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:12px;">
                <div>
                    <h1 style="font-family:'DM Serif Display', Georgia, serif; font-size:clamp(26px,4vw,36px); margin:0 0 4px 0;">
                        📚 Library Financial Analytics
                    </h1>
                    <p style="color:var(--fg-muted); font-size:14px; margin:0;">
                        Detailed revenue breakdown, pending dues, shift collection data, and 6-month trend.
                    </p>
                </div>
            </div>
        </div>

        <!-- 4 Summary Stat Cards -->
        <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(210px, 1fr)); gap:16px; margin-bottom:28px;">
            
            <!-- Revenue Collected -->
            <div style="background:#ffffff; border:1.5px solid var(--border); border-radius:var(--r-lg); padding:20px; box-shadow:0 4px 14px rgba(0,0,0,0.03);">
                <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:10px;">
                    <span style="font-size:12px; font-weight:700; color:var(--fg-muted); text-transform:uppercase; letter-spacing:0.5px;">Collected Revenue</span>
                    <span style="font-size:11px; font-weight:700; background:#ecfdf5; color:#047857; padding:3px 8px; border-radius:12px;">🟢 Paid</span>
                </div>
                <div style="font-size:28px; font-weight:800; color:#059669; font-family:'Inter', sans-serif;">
                    ₹<%= analytics ? analytics.totalPaid.toLocaleString('en-IN') : 0 %>
                </div>
                <div style="font-size:12px; color:var(--fg-muted); margin-top:6px;">
                    Received from <%= analytics ? analytics.paidCount : 0 %> paid students
                </div>
            </div>

            <!-- Pending Dues -->
            <div style="background:#ffffff; border:1.5px solid var(--border); border-radius:var(--r-lg); padding:20px; box-shadow:0 4px 14px rgba(0,0,0,0.03);">
                <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:10px;">
                    <span style="font-size:12px; font-weight:700; color:var(--fg-muted); text-transform:uppercase; letter-spacing:0.5px;">Pending Dues</span>
                    <span style="font-size:11px; font-weight:700; background:#fef2f2; color:#b91c1c; padding:3px 8px; border-radius:12px;">🔴 Overdue</span>
                </div>
                <div style="font-size:28px; font-weight:800; color:#dc2626; font-family:'Inter', sans-serif;">
                    ₹<%= analytics ? analytics.totalPending.toLocaleString('en-IN') : 0 %>
                </div>
                <div style="font-size:12px; color:var(--fg-muted); margin-top:6px;">
                    Pending from <%= analytics ? analytics.unpaidCount : 0 %> unpaid students
                </div>
            </div>

            <!-- Total Projected -->
            <div style="background:#ffffff; border:1.5px solid var(--border); border-radius:var(--r-lg); padding:20px; box-shadow:0 4px 14px rgba(0,0,0,0.03);">
                <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:10px;">
                    <span style="font-size:12px; font-weight:700; color:var(--fg-muted); text-transform:uppercase; letter-spacing:0.5px;">Target Total</span>
                    <span style="font-size:11px; font-weight:700; background:#eff6ff; color:#1d4ed8; padding:3px 8px; border-radius:12px;">🔵 Potential</span>
                </div>
                <div style="font-size:28px; font-weight:800; color:#2563eb; font-family:'Inter', sans-serif;">
                    ₹<%= analytics ? analytics.totalProjected.toLocaleString('en-IN') : 0 %>
                </div>
                <div style="font-size:12px; color:var(--fg-muted); margin-top:6px;">
                    Total 100% potential revenue
                </div>
            </div>

            <!-- Collection Rate -->
            <div style="background:#ffffff; border:1.5px solid var(--border); border-radius:var(--r-lg); padding:20px; box-shadow:0 4px 14px rgba(0,0,0,0.03);">
                <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:10px;">
                    <span style="font-size:12px; font-weight:700; color:var(--fg-muted); text-transform:uppercase; letter-spacing:0.5px;">Collection Rate</span>
                    <span style="font-size:11px; font-weight:700; background:#fef3c7; color:#b45309; padding:3px 8px; border-radius:12px;">🎯 Ratio</span>
                </div>
                <div style="font-size:28px; font-weight:800; color:var(--fg); font-family:'Inter', sans-serif;">
                    <%= analytics ? analytics.collectionRate : 0 %>%
                </div>
                <div style="width:100%; background:#e2e8f0; height:8px; border-radius:4px; margin-top:8px; overflow:hidden;">
                    <div style="width:<%= analytics ? analytics.collectionRate : 0 %>%; background:linear-gradient(90deg, #10b981, #2563eb); height:100%; border-radius:4px; transition:width 0.6s ease;"></div>
                </div>
            </div>

        </div>

        <!-- Shift-Wise Revenue Breakdown Grid -->
        <div style="background:#ffffff; border:1.5px solid var(--border); border-radius:var(--r-lg); padding:24px; margin-bottom:28px; box-shadow:0 4px 14px rgba(0,0,0,0.03);">
            <h2 style="font-family:'DM Serif Display', Georgia, serif; font-size:20px; color:var(--fg); margin:0 0 6px 0;">
                📋 Shift-Wise Revenue Breakdown
            </h2>
            <p style="color:var(--fg-muted); font-size:13.5px; margin:0 0 20px 0;">Revenue collected vs pending dues across all 5 library shifts.</p>

            <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(260px, 1fr)); gap:16px;">
                <% 
                   const shiftNames = {
                       '6am-10am': '6 AM – 10 AM',
                       '10am-2pm': '10 AM – 2 PM',
                       '2pm-6pm': '2 PM – 6 PM',
                       '6pm-10pm': '6 PM – 10 PM',
                       'night': 'Night Shift'
                   };
                   const shifts = analytics && analytics.shiftBreakdown ? Object.keys(analytics.shiftBreakdown) : [];
                   shifts.forEach(function(sh) {
                       const info = analytics.shiftBreakdown[sh];
                       const label = shiftNames[sh] || sh;
                       const totalRev = info.paidRev + info.pendingRev;
                       const rate = totalRev > 0 ? Math.round((info.paidRev / totalRev) * 100) : 0;
                %>
                    <div style="background:var(--bg-subtle); border:1px solid var(--border); border-radius:12px; padding:16px;">
                        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:8px;">
                            <span style="font-size:15px; font-weight:700; color:var(--fg);"><%= label %></span>
                            <span style="font-size:11.5px; font-weight:700; background:#e2e8f0; color:var(--fg); padding:2px 8px; border-radius:12px;"><%= info.total %> Enrolled</span>
                        </div>

                        <div style="display:flex; justify-content:space-between; font-size:13px; margin-bottom:6px;">
                            <span style="color:#059669; font-weight:700;">🟢 Paid: ₹<%= info.paidRev.toLocaleString('en-IN') %></span>
                            <span style="color:#dc2626; font-weight:700;">🔴 Overdue: ₹<%= info.pendingRev.toLocaleString('en-IN') %></span>
                        </div>

                        <div style="font-size:11.5px; color:var(--fg-muted); margin-bottom:8px;">
                            <%= info.paidCount %> paid students • <%= info.unpaidCount %> overdue students
                        </div>

                        <div style="width:100%; background:#e2e8f0; height:6px; border-radius:3px; overflow:hidden;">
                            <div style="width:<%= rate %>%; background:#10b981; height:100%; border-radius:3px;"></div>
                        </div>
                    </div>
                <% }); %>
            </div>
        </div>

        <!-- 6-Month Growth Trend Chart -->
        <div style="background:#ffffff; border:1.5px solid var(--border); border-radius:var(--r-lg); padding:24px; box-shadow:0 4px 14px rgba(0,0,0,0.03);">
            <div style="margin-bottom:18px;">
                <h2 style="font-family:'DM Serif Display', Georgia, serif; font-size:20px; color:var(--fg); margin:0 0 4px 0;">
                    📈 6-Month Library Revenue Trend
                </h2>
                <p style="font-size:13px; color:var(--fg-muted); margin:0;">Monthly collected revenue growth over the past 6 months.</p>
            </div>
            <div style="position:relative; width:100%; height:280px;">
                <canvas id="libraryTrendChart"></canvas>
            </div>
        </div>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const ctx = document.getElementById('libraryTrendChart');
            if (!ctx) return;

            const months = <%- JSON.stringify(analytics && analytics.chartData ? analytics.chartData.months : []) %>;
            const trend = <%- JSON.stringify(analytics && analytics.chartData ? analytics.chartData.trend : []) %>;

            new Chart(ctx, {
                type: 'line',
                data: {
                    labels: months,
                    datasets: [{
                        label: 'Library Collected Revenue (₹)',
                        data: trend,
                        borderColor: '#5b4fcf',
                        backgroundColor: 'rgba(91, 79, 207, 0.12)',
                        fill: true,
                        tension: 0.35,
                        pointBackgroundColor: '#5b4fcf',
                        pointBorderColor: '#ffffff',
                        pointBorderWidth: 2,
                        pointRadius: 5,
                        pointHoverRadius: 7
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            backgroundColor: '#0f172a',
                            titleFont: { family: 'Inter', size: 13, weight: '700' },
                            bodyFont: { family: 'Inter', size: 12 },
                            padding: 12,
                            cornerRadius: 8,
                            callbacks: {
                                label: function(ctx) { return 'Revenue: ₹' + ctx.raw.toLocaleString('en-IN'); }
                            }
                        }
                    },
                    scales: {
                        x: {
                            grid: { display: false },
                            ticks: { font: { family: 'Inter', size: 12, weight: '600' } }
                        },
                        y: {
                            beginAtZero: true,
                            grid: { color: '#f1f5f9' },
                            ticks: {
                                font: { family: 'Inter', size: 11 },
                                callback: function(v) { return '₹' + v.toLocaleString('en-IN'); }
                            }
                        }
                    }
                }
            });
        });
    </script>
</body>
</html>
